import json
from collections import Counter
from pathlib import Path

case = Path("output/aligned_comparison/20260930T051554_923434Z_surya")
run = sorted(case.glob("reference_before_*"))[-1]
manifest = json.loads((run / "manifest.json").read_text())
response = manifest["requests"][0]["response_file"]

def load(path):
    rows = json.loads(path.read_text())["data"]
    return {
        r["id"]: {
            "title": r.get("title"),
            "scope": r.get("scope"),
            "has_project": "project" in r,
            "childIds": sorted(r.get("childIds", [])),
        } for r in rows
    }

old = load(case / "folder_tree.json")
new = load(run / response)
changes = [
    (fid, [k for k in old[fid] if old[fid][k] != new[fid][k]])
    for fid in sorted(old.keys() & new.keys())
    if old[fid] != new[fid]
]
print("Added folder records:", len(new.keys() - old.keys()))
print("Removed folder records:", len(old.keys() - new.keys()))
print("Changed fields:", dict(Counter(k for _, fields in changes for k in fields)))
for fid, fields in changes[:8]:
    print(fid, ", ".join(fields))
PY
