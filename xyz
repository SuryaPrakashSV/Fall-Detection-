WITH CURRENT_KEYS AS (
    SELECT DISTINCT
        GRANULARITY_LEVEL,
        GEO,
        EMPLOYEE_ROLE,
        EMPLOYEE_TYPE,
        PROJECT_TYPE,
        FISCYEAR,
        FISCMONTH,
        STD_FISCAL_PERIOD_NAME,
        PERIOD_DISPLAY_NAME
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.SUPPLY_FORECAST
),

NEW_KEYS AS (
    SELECT DISTINCT
        GRANULARITY_LEVEL,
        GEO,
        EMPLOYEE_ROLE,
        EMPLOYEE_TYPE,
        PROJECT_TYPE,
        FISCYEAR,
        FISCMONTH,
        STD_FISCAL_PERIOD_NAME,
        PERIOD_DISPLAY_NAME
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.SUPPLY_FORECAST_NEW
)

SELECT
    'CURRENT_KEY_ONLY' AS DIFFERENCE_SOURCE,
    C.*
FROM (
    SELECT * FROM CURRENT_KEYS
    MINUS
    SELECT * FROM NEW_KEYS
) C

UNION ALL

SELECT
    'NEW_KEY_ONLY' AS DIFFERENCE_SOURCE,
    N.*
FROM (
    SELECT * FROM NEW_KEYS
    MINUS
    SELECT * FROM CURRENT_KEYS
) N;



