"""Genuinely independent verification of a project's full task list.

The earlier verify_closure_depth.py / resolve_scope.py comparison was NOT
actually independent: its "Method B" (closure-walk) was seeded with
Method A's own output, so method_a_ids was a subset of method_b_ids BY
CONSTRUCTION - "0 delta" there only proved Method B found no additional
tasks by following subTaskIds from what Method A already returned. It
could never have detected Method A silently omitting an entire branch.

This script fixes that. It builds Method B from scratch, using a
completely different Wrike API endpoint that never touches task data at
all until the very last step:

  Method A: the existing descendants=true recursive folder-tasks call
            (what reconcile_project_direct.py uses in production).
  Method B: WE independently walk the FOLDER tree ourselves via
            GET /folders/{id}/folders (child folders, not tasks), to
            build the complete list of every descendant folder under the
            project. Then, for EACH folder found, we fetch that folder's
            own tasks individually (subTasks=true, no descendants flag -
            so Wrike's own recursive-descendants logic is never invoked
            for Method B at all) and union everything together.

Because Method B never starts from or references Method A's result at
any point, agreement between the two is now real evidence that the
descendants=true call isn't silently dropping a branch - not a
mathematical guarantee.

Usage:
    python3 verify_independent_folder_walk.py \
        --project-id MQAAAABooWQv \
        --project-name "FY26 Earth Day"
"""

from __future__ import annotations

import argparse
import getpass
import os
import time
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime

import requests

API_BASE = "https://www.wrike.com/api/v4"


def token() -> str:
    value = os.getenv("WRIKE_TOKEN", "").strip()
    return value or getpass.getpass("Wrike token (hidden; not saved): ").strip()


def get_with_backoff(url, headers, params=None, max_retries=6, timeout=60):
    for attempt in range(max_retries):
        resp = requests.get(url, headers=headers, params=params, timeout=timeout)
        if resp.status_code != 429 or attempt == max_retries - 1:
            return resp
        retry_after = resp.headers.get("Retry-After")
        wait = None
        if retry_after:
            try:
                wait = max(0.0, float(retry_after))
            except ValueError:
                try:
                    retry_dt = parsedate_to_datetime(retry_after)
                    if retry_dt.tzinfo is None:
                        retry_dt = retry_dt.replace(tzinfo=timezone.utc)
                    wait = max(0.0, (retry_dt - datetime.now(timezone.utc)).total_seconds())
                except (TypeError, ValueError):
                    wait = None
        if wait is None:
            wait = min(120, 5 * (2 ** attempt))
        print(f"Rate limited (429). Waiting {wait:.0f}s before retry {attempt + 1}/{max_retries}...")
        time.sleep(wait)
    return resp


# ---------------------------------------------------------------------------
# Method A: the existing production approach (unchanged from
# reconcile_project_direct.py) - one call, Wrike does the recursion.
# ---------------------------------------------------------------------------
def method_a_descendants_call(project_id: str, headers: dict) -> set[str]:
    all_ids: set[str] = set()
    next_page_token = None
    page = 1
    while True:
        params = (
            {"nextPageToken": next_page_token}
            if next_page_token
            else {"descendants": "true", "subTasks": "true", "fields": '["subTaskIds"]'}
        )
        resp = get_with_backoff(f"{API_BASE}/folders/{project_id}/tasks", headers, params=params)
        if not resp.ok:
            print(f"\n[Method A] Request failed ({resp.status_code}): {resp.text}\n")
        resp.raise_for_status()
        payload = resp.json()
        page_tasks = payload.get("data", [])
        all_ids.update(t["id"] for t in page_tasks)
        print(f"  [Method A] Page {page}: {len(page_tasks)} tasks (running total {len(all_ids)})")
        next_page_token = payload.get("nextPageToken")
        if not next_page_token:
            break
        page += 1
    return all_ids


# ---------------------------------------------------------------------------
# Method B: independent folder-tree walk, never touching Method A's output.
# ---------------------------------------------------------------------------
def list_child_folders(folder_id: str, headers: dict) -> list[str]:
    """One level of GET /folders/{id}/folders - direct children only."""
    resp = get_with_backoff(f"{API_BASE}/folders/{folder_id}/folders", headers)
    if not resp.ok:
        print(f"  [Method B] Could not list children of {folder_id}: {resp.status_code} {resp.text}")
        return []
    resp.raise_for_status()
    return [f["id"] for f in resp.json().get("data", [])]


def discover_all_subfolders(project_id: str, headers: dict) -> list[str]:
    """Recursively walk the FOLDER tree (not tasks) starting from the
    project itself, using a breadth-first search over GET
    /folders/{id}/folders. Returns every folder ID in the tree, including
    the project's own ID. This never looks at task data.
    """
    all_folders = [project_id]
    seen = {project_id}
    frontier = [project_id]
    depth = 0

    while frontier:
        depth += 1
        next_frontier: list[str] = []
        for folder_id in frontier:
            children = list_child_folders(folder_id, headers)
            for child_id in children:
                if child_id not in seen:
                    seen.add(child_id)
                    all_folders.append(child_id)
                    next_frontier.append(child_id)
        print(f"  [Method B] Folder-tree depth {depth}: {len(next_frontier)} new folder(s), {len(all_folders)} total so far")
        frontier = next_frontier

    return all_folders


def fetch_tasks_for_one_folder(folder_id: str, headers: dict) -> set[str]:
    """Non-recursive task fetch for exactly one folder - deliberately NO
    descendants=true, so Wrike's own recursive logic is never invoked
    here. subTasks=true still expands subtasks belonging to this folder's
    own tasks (a task-level relationship, not a folder-level one).
    """
    task_ids: set[str] = set()
    next_page_token = None
    while True:
        params = (
            {"nextPageToken": next_page_token}
            if next_page_token
            else {"subTasks": "true", "fields": '["subTaskIds"]'}
        )
        resp = get_with_backoff(f"{API_BASE}/folders/{folder_id}/tasks", headers, params=params)
        if not resp.ok:
            print(f"  [Method B] Task fetch failed for folder {folder_id}: {resp.status_code} {resp.text}")
            return task_ids
        resp.raise_for_status()
        payload = resp.json()
        task_ids.update(t["id"] for t in payload.get("data", []))
        next_page_token = payload.get("nextPageToken")
        if not next_page_token:
            break
    return task_ids


def method_b_independent_walk(project_id: str, headers: dict) -> set[str]:
    print("  [Method B] Discovering the folder tree independently (GET /folders/{id}/folders)...")
    all_folders = discover_all_subfolders(project_id, headers)
    print(f"  [Method B] Found {len(all_folders)} folder(s) total (project + all descendants)")

    all_task_ids: set[str] = set()
    for i, folder_id in enumerate(all_folders, 1):
        folder_tasks = fetch_tasks_for_one_folder(folder_id, headers)
        all_task_ids.update(folder_tasks)
        if i % 10 == 0 or i == len(all_folders):
            print(f"  [Method B] Fetched tasks for {i}/{len(all_folders)} folders (running total {len(all_task_ids)} tasks)")
    return all_task_ids


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project-id", required=True)
    parser.add_argument("--project-name", default="")
    args = parser.parse_args()

    headers = {"Authorization": f"Bearer {token()}"}

    print(f"\n{'=' * 70}\nVerifying {args.project_name or args.project_id}\n{'=' * 70}")

    print("\nMethod A: Wrike's own descendants=true recursive call")
    method_a_ids = method_a_descendants_call(args.project_id, headers)
    print(f"Method A total: {len(method_a_ids)}")

    print("\nMethod B: independent folder-tree walk (never touches Method A's data)")
    method_b_ids = method_b_independent_walk(args.project_id, headers)
    print(f"Method B total: {len(method_b_ids)}")

    only_in_a = method_a_ids - method_b_ids
    only_in_b = method_b_ids - method_a_ids

    print(f"\n{'=' * 70}\nResult\n{'=' * 70}")
    print(f"Method A (descendants=true):        {len(method_a_ids)}")
    print(f"Method B (independent folder walk): {len(method_b_ids)}")
    print(f"In A but not B (delta):             {len(only_in_a)}")
    print(f"In B but not A (delta):             {len(only_in_b)}")

    if not only_in_a and not only_in_b:
        print("\n0 delta both directions - and this time it's REAL agreement, since Method B")
        print("never referenced Method A's output at any point. The descendants=true call")
        print("is confirmed not to be silently dropping any branch of this project's tree.")
    else:
        if only_in_a:
            print(f"\nTasks Method A found that Method B missed: {sorted(only_in_a)[:20]}")
        if only_in_b:
            print(f"\nTasks Method B found that Method A missed: {sorted(only_in_b)[:20]}")
        print("\nDELTA FOUND - worth investigating which method is right before trusting this project's count.")


if __name__ == "__main__":
    main()
