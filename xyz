import csv
from pathlib import Path

source = Path("output/effort_reconciliation/20260929T172437_318678Z/missing_projects_effort_hours.csv")
destination = Path("missing_project_hours_for_akash.csv")

with source.open(encoding="utf-8-sig", newline="") as f:
    rows = list(csv.DictReader(f))

assert len(rows) == 56, f"Expected 56 projects; found {len(rows)}"
assert len({r["project_id"] for r in rows}) == 56, "Duplicate project IDs"
assert all(r["effort_hours"].strip() and r["status"] in
           {"CALCULATED", "NO_RECORDED_TASKS"} for r in rows), "Review incomplete calculations"

columns = ["project_id", "project_name", "effort_hours"]
with destination.open("x", encoding="utf-8-sig", newline="") as f:
    writer = csv.DictWriter(f, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerows(rows)

print(f"Saved 56 projects: {destination.resolve()}")
PY
