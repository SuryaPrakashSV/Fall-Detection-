#!/usr/bin/env python3
"""Calculate recorded task effort from saved CSVs; no network or external writes.

Metric: effortAllocation_totalEffort, in minutes, once per unique metadata task
key; divide by 60 for hours. This is planned/recorded task effort, not timelog
actual hours. Owner/day expansions and hierarchy repetition are collapsed only
when every occurrence of a task has the same valid nonnegative value. Source
zeros are retained (the upstream pipeline may have replaced missing with zero).

Project membership is the union of id and the five folder hierarchy columns.
Project totals therefore overlap and must NOT be summed. Global totals count a
task once even if it appears in multiple projects. Folder/project own records
are excluded to avoid mixing their effort with descendant task effort.

Run in the folder containing this script, snowflake_effort_evidence.csv and
missing_items.csv: python3 calculate_wrike_effort.py
Only Python's standard library is required. Inputs remain unchanged.
"""
import argparse
import csv
import hashlib
import json
import re
import sys
from collections import Counter, defaultdict
from datetime import datetime, timezone
from decimal import Decimal, InvalidOperation, getcontext
from pathlib import Path

getcontext().prec = 60
csv.field_size_limit(16 * 1024 * 1024)
FOLDERS = ('parent_folder_id', 'child_folder_id', 'grandchild_folder_id',
           'baby_folder_id', 'grandbaby_folder_id')
TASKS = ('parent_task_id', 'child_task_id', 'grandchild_task_id',
         'baby_task_id', 'grandbaby_task_id', 'great_grandbaby_task_id')
METRIC = 'effortAllocation_totalEffort'
NULLS = {'', 'null', 'none', 'nan', 'nat', '<na>', '\\n'}
NUMERIC = re.compile(r'[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?\Z')
SAVED_SURYA = 'output/local_validation/20260924T213922_287354Z/wrike_local_full.csv'
SAVED_AKASH = 'output/local_validation/20260925T001910_967424Z/wrike_local_full.csv'
MISSING_FALLBACK = ('output/akash_comparison/20260925T002311_148327Z_73a909/'
                    'targeted_check_20260925T005523_170267Z/lookup_results.csv')


def clean(value):
    return (value or '').strip()


def ident(value):
    value = clean(value)
    return '' if value.lower() in NULLS or value.upper() == 'PLACEHOLDER' else value


def numeric(value):
    value = clean(value)
    if value.lower() in NULLS:
        return None, 'NULL_EFFORT'
    if len(value) > 100 or not NUMERIC.fullmatch(value):
        return None, 'INVALID_EFFORT'
    try:
        number = Decimal(value)
        if not number.is_finite() or (number and abs(number.adjusted()) > 30):
            return None, 'INVALID_EFFORT'
        return (None, 'NEGATIVE_EFFORT') if number < 0 else (number, '')
    except InvalidOperation:
        return None, 'INVALID_EFFORT'


def hours(value):
    return '' if value is None else format(value / Decimal(60), '.10f').rstrip('0').rstrip('.')


def fingerprint(path):
    before = path.stat()
    digest = hashlib.sha256()
    with path.open('rb') as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
            digest.update(chunk)
    after = path.stat()
    facts = lambda s: (s.st_size, s.st_mtime_ns, s.st_ino)
    if facts(before) != facts(after):
        raise ValueError('Input changed while hashing: ' + str(path))
    return {'path': str(path), 'bytes': after.st_size, 'mtime_ns': after.st_mtime_ns,
            'sha256': digest.hexdigest()}


def csv_rows(path, required):
    with path.open('r', encoding='utf-8-sig', newline='') as handle:
        reader = csv.DictReader(handle, strict=True)
        headers = [clean(h) for h in (reader.fieldnames or [])]
        if not headers or '' in headers or len(headers) != len(set(headers)):
            raise ValueError(str(path) + ': empty/duplicate CSV headers')
        absent = sorted(set(required) - set(headers))
        if absent:
            raise ValueError(str(path) + ': missing columns ' + ', '.join(absent))
        reader.fieldnames = headers
        for row in reader:
            if None in row or any(v is None for v in row.values()):
                raise ValueError(str(path) + ': malformed row near line ' + str(reader.line_num))
            yield row


def stable(path, before):
    if fingerprint(path) != before:
        raise ValueError('Input changed during calculation: ' + str(path))


def read_cohort(path):
    before = fingerprint(path)
    result = {}
    required = ('project_id', 'snowflake_name', 'is_confirmed_project_in_snowflake',
                'in_akash_reference', 'outcome', 'http_status')
    for row in csv_rows(path, required):
        pid = ident(row['project_id'])
        flag, error = numeric(row['is_confirmed_project_in_snowflake'])
        reference, ref_error = numeric(row['in_akash_reference'])
        status, status_error = numeric(row['http_status'])
        if not pid or pid in result:
            raise ValueError('The missing-items file has a blank/placeholder or duplicate project ID')
        if error or flag not in (0, 1) or ref_error or reference not in (0, 1):
            raise ValueError('Expected 0/1 classification and reference flags for ' + pid)
        if clean(row['outcome']) != 'NOT_FOUND' or status_error or status != 404:
            raise ValueError('Expected the saved NOT_FOUND / 404 outcome for ' + pid)
        result[pid] = {'project_id': pid, 'project_name': clean(row['snowflake_name']),
                       'confirmed_project': int(flag), 'in_akash_reference': int(reference)}
    if len(result) != 61 or sum(v['confirmed_project'] for v in result.values()) != 56:
        raise ValueError('Use the original 61-item missing_items.csv containing 56 confirmed projects')
    stable(path, before)
    before['data_rows'] = len(result)
    return result, before


class Dataset:
    def __init__(self, label, path, cohort, evidence=False, expected_rows=None):
        self.label, self.path = label, path
        self.tasks = {}
        self.scope_tasks, self.direct_tasks = defaultdict(set), defaultdict(set)
        self.scope_rows, self.direct_rows = Counter(), Counter()
        self.scope_ambiguity, self.direct_ambiguity = Counter(), Counter()
        self.mapping_counts, self.effort_counts = Counter(), Counter()
        self.refresh = Counter()
        self.exported = Counter()
        self.ambiguous_keys, self.folder_keys = set(), set()
        self.unknown_identity_rows = 0
        before = fingerprint(path)
        required = ['id', 'key', METRIC, 'Data refresh', *FOLDERS, *TASKS]
        if evidence:
            required += ['evidence_exported_at', 'evidence_total_rows']
        count, expected, marker_errors = 0, set(), Counter()
        for row in csv_rows(path, required):
            count += 1
            if count % 50000 == 0:
                print(f'{label}: read {count:,} rows', flush=True)
            self.refresh[clean(row['Data refresh']) or '(blank)'] += 1
            if evidence:
                export_time = clean(row['evidence_exported_at'])
                self.exported[export_time] += 1
                value, error = numeric(row['evidence_total_rows'])
                if error or value <= 0 or value != value.to_integral_value():
                    marker_errors['invalid_count_marker_rows'] += 1
                else:
                    expected.add(int(value))
            key, container = ident(row['key']), ident(row['id'])
            folders = {ident(row[name]) for name in FOLDERS} - {''}
            scopes = (folders | {container}) & cohort.keys()
            direct = {container} & cohort.keys()
            self.scope_rows.update(scopes)
            self.direct_rows.update(direct)
            task_path = [ident(row[name]) for name in TASKS]
            deepest = next((v for v in reversed(task_path) if v), '')
            folder_identity = bool(key and (key == container or key in folders))
            contradictory_identity = bool(folder_identity and key in task_path)
            if folder_identity and not contradictory_identity:
                self.mapping_counts['folder_or_project_own_rows_excluded'] += 1
                self.folder_keys.add(key)
                continue
            if contradictory_identity or not key or not deepest or key != deepest:
                self.mapping_counts['ambiguous_identity_rows'] += 1
                self.unknown_identity_rows += 1
                self.scope_ambiguity.update(scopes)
                self.direct_ambiguity.update(direct)
                if key:
                    self.ambiguous_keys.add(key)
                continue
            self.mapping_counts['task_rows'] += 1
            value, error = numeric(row[METRIC])
            self.effort_counts[error or ('ZERO_EFFORT' if value == 0 else 'POSITIVE_EFFORT')] += 1
            task = self.tasks.setdefault(key, {'values': set(), 'issues': set(), 'rows': 0})
            task['rows'] += 1
            if error:
                task['issues'].add(error)
            else:
                task['values'].add(value)
            for pid in scopes:
                self.scope_tasks[pid].add(key)
            for pid in direct:
                self.direct_tasks[pid].add(key)
        if evidence and (marker_errors or expected != {count} or
                         len(self.exported) != 1 or any(v.lower() in NULLS for v in self.exported)):
            raise ValueError('Snowflake export completeness check failed: ' +
                             str({'read_rows': count, 'count_markers': sorted(expected),
                                  'marker_errors': dict(marker_errors),
                                  'export_time_count': len(self.exported)}))
        if expected_rows is not None and count != expected_rows:
            raise ValueError(f'{label}: expected {expected_rows:,} rows in this saved snapshot; found {count:,}')
        if not count:
            raise ValueError(label + ': empty export')
        for key, task in self.tasks.items():
            if len(task['values']) > 1:
                task['issues'].add('CONFLICTING_EFFORT')
            if key in self.ambiguous_keys or key in self.folder_keys:
                task['issues'].add('AMBIGUOUS_IDENTITY')
            task['minutes'] = (next(iter(task['values']))
                               if len(task['values']) == 1 and not task['issues'] else None)
        stable(path, before)
        before.update(data_rows=count, data_refresh_counts=dict(self.refresh),
                      evidence_exported_at_counts=dict(self.exported))
        self.audit = before

    def total(self, keys, identity_block=False):
        keys = set(keys)
        unknown = sum(self.tasks[k]['minutes'] is None for k in keys)
        value = None if unknown or identity_block else sum(
            (self.tasks[k]['minutes'] for k in keys), Decimal(0))
        return {'task_count': len(keys), 'unknown_effort_task_count': unknown,
                'identity_block': bool(identity_block), 'minutes': value,
                'hours': hours(value)}

    def details(self):
        issues = Counter(issue for task in self.tasks.values() for issue in task['issues'])
        return {'input': self.audit, 'mapping_counts': dict(self.mapping_counts),
                'effort_row_counts': dict(self.effort_counts),
                'task_issue_counts': dict(issues),
                'repeated_task_rows_collapsed': sum(t['rows'] - 1 for t in self.tasks.values()),
                'recorded_unique_task_effort': self.total(self.tasks, self.unknown_identity_rows)}


def project_rows(data, cohort, project_ids):
    memberships = Counter(k for pid in project_ids for k in data.scope_tasks[pid])
    output = []
    for pid in sorted(cohort, key=lambda p: (cohort[p]['project_name'].casefold(), p)):
        item, keys = cohort[pid], data.scope_tasks[pid]
        inclusive = data.total(keys, data.scope_ambiguity[pid])
        direct = data.total(data.direct_tasks[pid], data.direct_ambiguity[pid])
        issues = sorted({issue for k in keys for issue in data.tasks[k]['issues']})
        if data.scope_ambiguity[pid]:
            issues.append('AMBIGUOUS_IDENTITY_ROWS')
        if not data.scope_rows[pid]:
            issues.append('ID_ABSENT_FROM_EXPORTED_HIERARCHY')
            inclusive.update(minutes=None, hours='')
        if not data.direct_rows[pid]:
            direct.update(minutes=None, hours='')
        status = 'INCOMPLETE' if issues else ('NO_RECORDED_TASKS' if not keys else 'CALCULATED')
        output.append({'project_id': pid, 'project_name': item['project_name'],
            'is_confirmed_project_in_saved_baseline': item['confirmed_project'],
            'effort_hours': inclusive['hours'], 'task_count': len(keys),
            'unknown_effort_task_count': inclusive['unknown_effort_task_count'],
            'status': status, 'issues': '; '.join(issues),
            'shared_with_other_missing_projects_task_count':
                sum(memberships[k] > 1 for k in keys) if pid in project_ids else '',
            'direct_container_effort_hours': direct['hours'],
            'direct_container_task_count': direct['task_count'],
            'direct_container_status': ('ID_ABSENT_AS_DIRECT_CONTAINER' if not data.direct_rows[pid]
                else 'INCOMPLETE' if direct['minutes'] is None
                else 'NO_RECORDED_TASKS' if not direct['task_count'] else 'CALCULATED'),
            'hierarchy_scope_dataset_rows': data.scope_rows[pid],
            'scope_ambiguous_identity_rows': data.scope_ambiguity[pid],
            'in_akash_reference': item['in_akash_reference'],
            'scope_note': 'Task keys under id or five folder hierarchy IDs; overlapping project totals',
            'metric_note': 'Recorded task effortAllocation_totalEffort minutes / 60; source zeros retained'})
    return output


def bridge(baseline, akash, project_ids):
    a, b = set(baseline.tasks), set(akash.tasks)
    shared, a_only, b_only = a & b, a - b, b - a
    cohort_tasks = set().union(*(baseline.scope_tasks[p] for p in project_ids))
    missing_only, outside = a_only & cohort_tasks, a_only - cohort_tasks
    groups = {'baseline': baseline.total(a, baseline.unknown_identity_rows),
              'akash': akash.total(b, akash.unknown_identity_rows),
              'baseline_only_in_56': baseline.total(missing_only),
              'baseline_only_outside_56': baseline.total(outside),
              'akash_only': akash.total(b_only),
              'baseline_56_task_union': baseline.total(cohort_tasks,
                  sum(baseline.scope_ambiguity[p] for p in project_ids) or
                  any(not baseline.scope_rows[p] for p in project_ids))}
    unknown = sum(baseline.tasks[k]['minutes'] is None or akash.tasks[k]['minutes'] is None
                  for k in shared)
    delta = None if unknown else sum(
        (baseline.tasks[k]['minutes'] - akash.tasks[k]['minutes'] for k in shared), Decimal(0))
    groups['shared_task_effort_delta'] = {'task_count': len(shared),
        'unknown_effort_task_count': unknown, 'minutes': delta, 'hours': hours(delta)}
    terms = [groups[name]['minutes'] for name in ('baseline', 'akash', 'akash_only',
             'shared_task_effort_delta', 'baseline_only_in_56', 'baseline_only_outside_56')]
    residual = None if any(v is None for v in terms) else terms[0] - (
        terms[1] - terms[2] + terms[3] + terms[4] + terms[5])
    simple = [groups[name]['minutes'] for name in ('baseline', 'akash', 'baseline_56_task_union')]
    simple_gap = None if any(v is None for v in simple) else simple[0] - simple[1] - simple[2]
    return {'baseline_label': baseline.label, 'akash_label': akash.label,
            'snapshot_note': 'Different saved snapshot times; arithmetic bridge only, not proof of API completeness or permissions',
            'equation': 'baseline = Akash - Akash_only + shared_effort_delta + baseline_only_in_56 + baseline_only_outside_56',
            'partitions': groups, 'arithmetic_residual_hours': hours(residual),
            'baseline_minus_Akash_minus_56_hours': hours(simple_gap),
            'tasks_in_baseline_56_and_Akash': len(cohort_tasks & b),
            'complete_arithmetic_bridge': residual is not None and residual == 0,
            'scope_note': 'Exclusive difference sets partition task IDs; project-level reports may overlap'}


def write_csv(path, rows):
    with path.open('x', encoding='utf-8-sig', newline='') as handle:
        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--evidence', help='Current Snowflake evidence CSV')
    parser.add_argument('--missing', help='Original 61-item missing_items.csv')
    parser.add_argument('--surya', help='Saved 211,897-row Surya export; optional comparison')
    parser.add_argument('--akash', help='Saved 169,002-row Akash export; optional comparison')
    parser.add_argument('--output', help='Parent folder for a new timestamped report directory')
    args = parser.parse_args()
    root = Path(__file__).resolve().parent
    resolve = lambda given, default: Path(given).expanduser().resolve() if given else root / default
    evidence = resolve(args.evidence, 'snowflake_effort_evidence.csv')
    # Prefer the archived 61-item result; the shared copy may have been filtered
    # or renamed in Numbers since the access comparison was completed.
    missing = resolve(args.missing, MISSING_FALLBACK)
    if not args.missing and not missing.is_file():
        missing = root / 'missing_items.csv'
    for path in (evidence, missing):
        if not path.is_file():
            raise ValueError('File not found: ' + str(path))
    cohort, cohort_audit = read_cohort(missing)
    project_ids = {p for p, item in cohort.items() if item['confirmed_project']}
    print('Calculating saved CSVs locally; no token or API calls are used.', flush=True)
    current = Dataset('Current Snowflake evidence', evidence, cohort, evidence=True)
    datasets, skipped = {'snowflake': current}, {}
    for name, given, default, expected in (
            ('surya', args.surya, SAVED_SURYA, 211897), ('akash', args.akash, SAVED_AKASH, 169002)):
        path = resolve(given, default)
        if not path.is_file():
            skipped[name] = 'SKIPPED: file not found: ' + str(path)
            continue
        try:
            datasets[name] = Dataset('Saved ' + name.capitalize() + ' export', path, cohort,
                                     expected_rows=expected)
        except (ValueError, OSError, UnicodeError, csv.Error) as error:
            skipped[name] = 'SKIPPED: ' + str(error)
    rows = project_rows(current, cohort, project_ids)
    projects = [row for row in rows if row['is_confirmed_project_in_saved_baseline']]
    excluded = [row for row in rows if not row['is_confirmed_project_in_saved_baseline']]
    union = set().union(*(current.scope_tasks[p] for p in project_ids))
    union_total = current.total(union, sum(current.scope_ambiguity[p] for p in project_ids))
    absent = [p for p in project_ids if not current.scope_rows[p]]
    if absent:
        union_total.update(minutes=None, hours='', scope_incomplete_ids=absent)
    memberships = Counter(k for p in project_ids for k in current.scope_tasks[p])
    comparisons = {}
    if 'akash' in datasets:
        comparisons['current_snowflake_vs_saved_akash'] = bridge(current, datasets['akash'], project_ids)
        if 'surya' in datasets:
            comparisons['saved_surya_vs_saved_akash'] = bridge(datasets['surya'], datasets['akash'], project_ids)
    notes = [
        'Metric: effortAllocation_totalEffort minutes / 60, one consistent value per unique task key.',
        'These are recorded planned task effort hours, not actual timelog hours or owner allocation hours.',
        'Null, invalid, negative or conflicting task effort remains UNKNOWN; affected totals are blank.',
        'Source zero values are retained; upstream imputation may mean zero does not prove no planned effort.',
        'Folder/project own rows are excluded; all task/subtask levels are included as distinct task keys.',
        'Project membership uses id plus five folder ancestors; per-project hours are NON-ADDITIVE.',
        'The 56-project union counts each task once. The five excluded item scopes can overlap it.',
        'No active/open status filter is applied. The original 56-project cohort remains fixed.',
        'Saved snapshots have different refresh times. Arithmetic equality is not proof of complete API extraction.',
        'No original files, Snowflake tables or Wrike data were changed.'
    ]
    details = {'report_generated_at_utc': datetime.now(timezone.utc).isoformat(),
        'cohort_input': cohort_audit, 'confirmed_project_count': len(project_ids),
        'excluded_item_count': len(excluded), 'metric': METRIC,
        'missing_56_unique_task_union': union_total,
        'tasks_shared_across_missing_project_scopes': sum(n > 1 for n in memberships.values()),
        'datasets': {name: data.details() for name, data in datasets.items()},
        'skipped_inputs': skipped, 'comparisons': comparisons, 'notes': notes}
    output = resolve(args.output, 'output/effort_reconciliation') / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S_%fZ')
    output.mkdir(parents=True, exist_ok=False)
    write_csv(output / 'missing_projects_effort_hours.csv', projects)
    write_csv(output / 'excluded_items_effort_hours.csv', excluded)
    summary = ['WRIKE RECORDED TASK EFFORT RECONCILIATION', '',
        f'Current Snowflake dataset rows: {current.audit["data_rows"]:,}',
        'Complete current CSV download check: PASSED (row count and single export marker)',
        f'Project report rows: {len(projects)}; excluded item rows: {len(excluded)}',
        f'Project statuses: {dict(Counter(row["status"] for row in projects))}',
        f'Unique task keys in the 56-project union: {len(union):,}',
        'Unique task effort hours in that union: ' + (union_total['hours'] or 'UNKNOWN'),
        f'Tasks shared across missing project scopes: {details["tasks_shared_across_missing_project_scopes"]:,}', '']
    for name, data in datasets.items():
        total = data.total(data.tasks, data.unknown_identity_rows)
        summary += [f'{name}: {data.audit["data_rows"]:,} rows; {len(data.tasks):,} unique mapped task keys; '
                    f'recorded effort hours {total["hours"] or "UNKNOWN"}',
                    '  Data refresh: ' + json.dumps(dict(data.refresh), ensure_ascii=False),
                    f'  Ambiguous identity rows: {data.unknown_identity_rows:,}; unknown task effort: {total["unknown_effort_task_count"]:,}']
    summary += ['', *skipped.values()]
    for name, comparison in comparisons.items():
        summary += ['', name, comparison['equation']]
        for term, amount in comparison['partitions'].items():
            summary.append(f'  {term}: {amount["hours"] or "UNKNOWN"} hours; {amount["task_count"]:,} tasks')
        summary += ['  Arithmetic residual: ' + (comparison['arithmetic_residual_hours'] or 'UNKNOWN') + ' hours',
                    '  Baseline minus (Akash + 56-project union): ' +
                    (comparison['baseline_minus_Akash_minus_56_hours'] or 'UNKNOWN') + ' hours']
    if not comparisons:
        summary += ['', 'COMPARISONS SKIPPED: a valid saved Akash export was not available.']
    summary += ['', *notes, '', 'Saved reports: ' + str(output)]
    (output / 'effort_reconciliation_summary.txt').write_text('\n'.join(summary) + '\n', encoding='utf-8')
    (output / 'effort_reconciliation_details.json').write_text(
        json.dumps(details, indent=2, ensure_ascii=False, default=str) + '\n', encoding='utf-8')
    print('\n'.join(summary), flush=True)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, UnicodeError, csv.Error) as exc:
        print('STOPPED: ' + str(exc), file=sys.stderr)
        sys.exit(1)
