WITH unique_statuses AS (
    SELECT DISTINCT
        TRIM("WORKFLOW_STATUS") AS WORKFLOW_STATUS_NAME
    FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
    WHERE NULLIF(TRIM("WORKFLOW_STATUS"), '') IS NOT NULL
)
SELECT
    WORKFLOW_STATUS_NAME,
    COUNT(*) OVER () AS TOTAL_UNIQUE_WORKFLOW_STATUSES
FROM unique_statuses
ORDER BY WORKFLOW_STATUS_NAME;



