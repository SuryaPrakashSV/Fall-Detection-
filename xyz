SET akash_cutoff = 'PASTE_DATA_REFRESH_VALUE_FROM_AKASH_EXPORT';

WITH cutoff AS (
    SELECT TO_TIMESTAMP_TZ(REGEXP_REPLACE($akash_cutoff, ' [A-Z]{3,4}', ' '),
                           'YYYY-MM-DD HH24:MI:SS TZHTZM') AS ts
),
folder_keys AS (
    SELECT DISTINCT "key" AS k
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE "key" = "id" AND "key" IS NOT NULL
),
per_task AS (
    SELECT
        "key",
        MAX(TRY_TO_TIMESTAMP_TZ("createdDate"::VARCHAR)) AS created_at,
        MAX(TRY_TO_TIMESTAMP_TZ("updatedDate"::VARCHAR)) AS updated_at,
        MAX(CASE WHEN LOWER(TRIM("effortAllocation_totalEffort"::VARCHAR)) IN ('', 'nan', 'none', 'null') THEN NULL
                 ELSE TRY_TO_DOUBLE("effortAllocation_totalEffort"::VARCHAR) END) AS effort_min
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE NULLIF(TRIM("key"), '') IS NOT NULL
      AND "key" NOT IN (SELECT k FROM folder_keys)
    GROUP BY "key"
)
SELECT
    c.ts                                              AS akash_cutoff_parsed,
    CASE
        WHEN p.created_at IS NULL THEN '4. no created date'
        WHEN p.created_at > c.ts  THEN '1. created after Akash snapshot (timing)'
        WHEN p.updated_at > c.ts  THEN '2. existed, changed since (maybe timing)'
        ELSE                           '3. unchanged since Akash snapshot'
    END                                               AS timing_bucket,
    COUNT(*)                                          AS tasks,
    SUM(CASE WHEN p.effort_min > 0 THEN 1 ELSE 0 END) AS tasks_with_effort,
    ROUND(COALESCE(SUM(p.effort_min), 0) / 60, 2)     AS effort_hours
FROM per_task p
CROSS JOIN cutoff c
GROUP BY 1, 2
ORDER BY 2;




WITH folder_keys AS (
    SELECT DISTINCT "key" AS k
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE "key" = "id" AND "key" IS NOT NULL
),
per_task AS (
    SELECT
        "key",
        MAX(CASE WHEN LOWER(TRIM("effortAllocation_totalEffort"::VARCHAR)) IN ('', 'nan', 'none', 'null') THEN NULL
                 ELSE TRY_TO_DOUBLE("effortAllocation_totalEffort"::VARCHAR) END) AS effort_min
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE NULLIF(TRIM("key"), '') IS NOT NULL
      AND "key" NOT IN (SELECT k FROM folder_keys)
    GROUP BY "key"
)
SELECT
    COUNT(*)                                                              AS tasks_with_effort,
    ROUND(MEDIAN(effort_min) / 60, 2)                                     AS median_hours,
    ROUND(APPROX_PERCENTILE(effort_min, 0.99) / 60, 2)                    AS p99_hours,
    ROUND(MAX(effort_min) / 60, 2)                                        AS max_hours,
    SUM(CASE WHEN effort_min >= 60000 THEN 1 ELSE 0 END)                  AS tasks_over_1000h,
    ROUND(SUM(CASE WHEN effort_min >= 60000 THEN effort_min END) / 60, 2) AS hours_in_tasks_over_1000h
FROM per_task
WHERE effort_min > 0;
