WITH latest AS (
    SELECT MAX("Data refresh") AS refresh_ts
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_STG           -- confirm table name
),
snap AS (
    SELECT s.*
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_STG s
    JOIN latest l ON s."Data refresh" = l.refresh_ts
),

-- A. Effort stored on the project row itself, taken once per project
project_level AS (
    SELECT "key" AS project_id,
           MAX("effortAllocation_totalEffort") AS effort_min
    FROM snap
    WHERE "is_project" = 'Y'
    GROUP BY "key"
),

-- B. Task effort: one value per task within each project, then summed per project
task_per_project AS (
    SELECT "PROJECT_ID" AS project_id,                                   -- replace with real column
           "key"        AS task_key,
           MAX("effortAllocation_totalEffort") AS effort_min
    FROM snap
    WHERE "is_project" = 'N'
    GROUP BY "PROJECT_ID", "key"
),
project_from_tasks AS (
    SELECT project_id, SUM(effort_min) AS effort_min, COUNT(*) AS tasks
    FROM task_per_project
    GROUP BY project_id
)

SELECT 'A: project-row effort, once per project'         AS method,
       COUNT(*) AS projects,
       ROUND(SUM(effort_min) / 60, 2) AS total_effort_hours
FROM project_level
UNION ALL
SELECT 'B: task effort summed per project, each project once',
       COUNT(*),
       ROUND(SUM(effort_min) / 60, 2)
FROM project_from_tasks
UNION ALL
SELECT 'Check: each task once, ignoring projects',
       NULL,
       ROUND(SUM(effort_min) / 60, 2)
FROM (SELECT task_key, MAX(effort_min) AS effort_min
      FROM task_per_project GROUP BY task_key);
