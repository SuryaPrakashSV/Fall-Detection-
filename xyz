WITH counts AS (

    SELECT
        'QUERY_1' AS query_name,
        'OWNER_PROJECT_WEEKLY_AGG' AS current_table,
        'OWNER_PROJECT_WEEKLY_AGG_NEW' AS new_table,
        (SELECT COUNT(*) FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.OWNER_PROJECT_WEEKLY_AGG) AS current_count,
        (SELECT COUNT(*) FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.OWNER_PROJECT_WEEKLY_AGG_NEW) AS new_count

    UNION ALL

    SELECT
