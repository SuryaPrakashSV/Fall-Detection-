FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG" AS t
WHERE COALESCE(
    NULLIF(NULLIF(UPPER(TRIM(t."parent_task_id")), 'PLACEHOLDER'), ''),
    NULLIF(NULLIF(UPPER(TRIM(t."child_task_id")), 'PLACEHOLDER'), ''),
    NULLIF(NULLIF(UPPER(TRIM(t."grandchild_task_id")), 'PLACEHOLDER'), ''),
    NULLIF(NULLIF(UPPER(TRIM(t."baby_task_id")), 'PLACEHOLDER'), ''),
    NULLIF(NULLIF(UPPER(TRIM(t."grandbaby_task_id")), 'PLACEHOLDER'), ''),
    NULLIF(NULLIF(UPPER(TRIM(t."great_grandbaby_task_id")), 'PLACEHOLDER'), '')
) IS NOT NULL;







WITH unique_statuses AS (
    SELECT DISTINCT
        TRIM("WORKFLOW_STATUS") AS WORKFLOW_STATUS_NAME
    FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
    WHERE NULLIF(TRIM("WORKFLOW_STATUS"), '') IS NOT NULL
)
SELECT
    WORKFLOW_STATUS_NAME,
    COUNT(*) OVER () AS TOTAL_UNIQUE_WORKFLOW_STATUSES
FROM unique_statuses
ORDER BY WORKFLOW_STATUS_NAME;






#!/usr/bin/env python3
"""Local, token-visible Wrike task snapshots, version 3. Python 3.9+.

Run: python3 wrike_task_snapshots.py capture
All API requests are GET requests. No production or database writes.

Readable custom status and workflow names are accompanied by a workflow_statuses.csv
catalog and unresolved_status_ids.csv. Labels are looked up after task capture
from account workflows and workflows in all returned spaces (including archived
spaces). Label lookup errors are reported separately from task capture errors.
Raw status IDs remain the basis of comparison. Names alone do not imply a task
transition. COMPLETE refers to task capture; workflow_lookup.status separately
describes the label catalog. Both remain limited to this token's visibility.

Version 3 provides general_status, workflow_status and task_updated_at as clear
column names, while retaining the original columns. task_updated_at (updatedDate)
is the TASK update time, not a status transition time. general_status_changed_at
and workflow_status_changed_at remain blank: this capture has no verified source
for exact status transition times. status_change_time_source explains why.
The *_last_change_observed_at columns record when a comparison first detected a
difference, not when the change happened. Baselines have no inferred change time.

Also saves task creation/completion dates, scheduling type, importance, custom
item type ID, raw custom fields, and any additional top-level status/state fields
returned in the task object. These attributes are not automatically lifecycle
statuses. Comparisons continue to use general status and raw custom status ID.
Separate objects such as approvals and timelogs are outside this task snapshot.

Reuse output/task_snapshots: version-1 and version-2 baselines are read without
modifying them. Newly added source fields stay blank for old baselines; readable
names absent from v1 are not backfilled with today's labels. Do not downgrade
the script after saving a version-3 snapshot. No history is reconstructed.

API references:
https://developers.wrike.com/reference/gettasksempty
https://developers.wrike.com/reference/getworkflowsempty
https://developers.wrike.com/reference/getspacessingleworkflows
https://developers.wrike.com/reference/gettasksmultitasks_history
"""

