python3 - <<'PY'
import subprocess
import sys
from pathlib import Path

base = Path("output/aligned_comparison")
existing = set(base.glob("*_surya"))

result = subprocess.run([
    sys.executable, "prepare_wrike_comparison.py", "--label", "surya"
])
if result.returncode:
    sys.exit(result.returncode)

created = set(base.glob("*_surya")) - existing
if len(created) != 1:
    sys.exit("Could not identify exactly one new preparation.")

sys.exit(subprocess.call([
    sys.executable, "capture_wrike_reference.py",
    "--case", str(created.pop()), "--phase", "before"
]))
PY
