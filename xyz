python3 - <<'PY'
import json
from pathlib import Path
from decimal import Decimal
import calculate_wrike_effort as c

reports = sorted(Path("output/effort_reconciliation").glob(
    "*/effort_reconciliation_details.json"
))
if not reports:
    raise SystemExit("No effort report found.")
details = json.loads(reports[-1].read_text())

cohort, audit = c.read_cohort(Path(details["cohort_input"]["path"]))
if audit["sha256"] != details["cohort_input"]["sha256"]:
    raise SystemExit("Cohort file changed. Stopping.")

projects = {p for p, item in cohort.items() if item["confirmed_project"]}
datasets = {}
for name in ("surya", "snowflake"):
    saved = details["datasets"][name]["input"]
    path = Path(saved["path"])
    if c.fingerprint(path)["sha256"] != saved["sha256"]:
        raise SystemExit(name + " source changed. Stopping.")
    datasets[name] = c.Dataset(
        name, path, cohort, evidence=(name == "snowflake"),
        expected_rows=saved["data_rows"]
    )

old, new = datasets["surya"], datasets["snowflake"]
old_scope = set().union(*(old.scope_tasks[p] for p in projects))
new_scope = set().union(*(new.scope_tasks[p] for p in projects))
shared = old_scope & new_scope
unknown = sum(
    old.tasks[k]["minutes"] is None or new.tasks[k]["minutes"] is None
    for k in shared
)
changed = [
    k for k in shared
    if old.tasks[k]["minutes"] != new.tasks[k]["minutes"]
]

print("\n56-PROJECT SNAPSHOT CHECK")
print("September 24 task count:", len(old_scope))
print("September 29 task count:", len(new_scope))
print("Only September 24:", len(old_scope - new_scope))
print("Only September 29:", len(new_scope - old_scope))
print("Shared tasks with unknown effort:", unknown)
print("Shared tasks with changed effort:", len(changed))
print("September 24 hours:", old.total(old_scope)["hours"])
print("September 29 hours:", new.total(new_scope)["hours"])
PY
