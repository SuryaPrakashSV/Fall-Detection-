python3 - <<'PY'
import ast
import textwrap
from pathlib import Path

tree = ast.parse(Path("Wrike_Data_local_validation.py").read_text())
operations = {
    "merge", "join", "concat", "dropna", "drop_duplicates",
    "query", "groupby", "pivot", "pivot_table", "explode"
}

for node in sorted(ast.walk(tree), key=lambda n: getattr(n, "lineno", 0)):
    if not isinstance(node, ast.Assign) or node.lineno < 1450:
        continue
    targets = " ".join(ast.unparse(t) for t in node.targets)
    relevant = "df_" in targets or any(
        isinstance(n, ast.Call)
        and isinstance(n.func, ast.Attribute)
        and n.func.attr in operations
        for n in ast.walk(node.value)
    )
    if relevant:
        print(f"\nLine {node.lineno}:")
        print(textwrap.fill(ast.unparse(node), width=110))
PY
