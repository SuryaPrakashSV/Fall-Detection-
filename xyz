WITH task_rows AS (
    SELECT
        NULLIF(TRIM("status"), '') AS general_status,
        NULLIF(TRIM("customStatusId"), '') AS workflow_status
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE COALESCE(
        NULLIF(NULLIF(UPPER(TRIM("parent_task_id")), 'PLACEHOLDER'), ''),
        NULLIF(NULLIF(UPPER(TRIM("child_task_id")), 'PLACEHOLDER'), ''),
        NULLIF(NULLIF(UPPER(TRIM("grandchild_task_id")), 'PLACEHOLDER'), ''),
        NULLIF(NULLIF(UPPER(TRIM("baby_task_id")), 'PLACEHOLDER'), ''),
        NULLIF(NULLIF(UPPER(TRIM("grandbaby_task_id")), 'PLACEHOLDER'), ''),
        NULLIF(NULLIF(UPPER(TRIM("great_grandbaby_task_id")), 'PLACEHOLDER'), '')
    ) IS NOT NULL
)
SELECT DISTINCT
    general_status,
    workflow_status,
    COUNT(DISTINCT general_status) OVER () AS general_status_count,
    COUNT(DISTINCT workflow_status) OVER () AS workflow_status_count
FROM task_rows
ORDER BY general_status, workflow_status;



