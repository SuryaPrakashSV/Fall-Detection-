        EMPLOYEE_ROLE, EMPLOYEE_TYPE, GEO, PROJECT_TYPE
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.DEMAND_FORECAST_NEW
),
diff AS (
    SELECT 'ONLY_IN_CURRENT' AS comparison, *
    FROM (SELECT * FROM current_keys MINUS SELECT * FROM new_keys)

    UNION ALL

    SELECT 'ONLY_IN_NEW' AS comparison, *
    FROM (SELECT * FROM new_keys MINUS SELECT * FROM current_keys)
)
