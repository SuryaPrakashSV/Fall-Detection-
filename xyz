import csv, json
from collections import Counter
from pathlib import Path

case = Path("output/aligned_comparison/20260930T054149_860457Z_surya")
review = sorted(case.glob("difference_review_*"))[-1]
s = json.loads((review / "review_summary.json").read_text())
evidence = json.loads((review / "task_evidence.json").read_text())
ids = {r["task_id"] for r in s["root_membership_differences"]}

print("Previously omitted log patterns:")
for row in s["log_groups"][12:]:
    print(json.dumps(row))

print("\nReference relationships for the three tasks:")
for row in evidence:
    if row["task_id"] in ids:
        for variant in row["after"]["variants"]:
            t = variant["task"]
            print(json.dumps({k: t.get(k) for k in
                  ("id", "parentIds", "superParentIds", "superTaskIds")}))

cols = ("id", "parent_folder_id", "child_folder_id",
        "grandchild_folder_id", "baby_folder_id", "grandbaby_folder_id")
paths = {tid: Counter() for tid in ids}
file = Path("output/local_validation/20260930T132340_154686Z/wrike_local_full.csv")
with file.open(newline="", encoding="utf-8-sig") as f:
    for row in csv.DictReader(f):
        if row["key"] in ids:
            paths[row["key"]][tuple(row.get(c, "") for c in cols)] += 1

print("\nCSV folder paths:")
for tid, combinations in sorted(paths.items()):
    for values, count in combinations.items():
        print(tid, "rows:", count, dict(zip(cols, values)))
