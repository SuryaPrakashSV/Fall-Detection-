python3 - <<'PY'
import json
from pathlib import Path
import review_wrike_effort_gaps as g

reviews = sorted(Path("output/effort_reconciliation").glob(
    "*/gap_review_*/review_inputs.json"
))
if not reviews:
    raise SystemExit("No saved gap review found.")

review = reviews[-1].parent
report = review.parent
details = json.loads(
    (report / "effort_reconciliation_details.json").read_text()
)

data = {}
for name in (g.OLD, g.NEW):
    comparison = details["comparisons"][name]
    data[name], _ = g.read_differences(
        report / comparison["task_difference_file"], comparison
    )

old_ids = {r["task_id"] for r in data[g.OLD]}
new_exceptions = [
    r for r in data[g.NEW] if r["task_id"] not in old_ids
]

names = {"snowflake": {}, "akash": {}}
group_file = review / ("container_groups_" + g.NEW + ".csv")
for row in g.rows_from(group_file):
    for side, source in (("baseline", "snowflake"), ("akash", "akash")):
        names[source].update(
            json.loads(row[side + "_container_names_json"])
        )

groups = g.group_rows(new_exceptions, names, "snowflake")

for kind in g.KINDS:
    tasks = [r for r in new_exceptions if r["difference_type"] == kind]
    if not tasks:
        continue
    print(f"\n{kind}: {len(tasks)} tasks; {g.display(g.total(tasks))} hours")
    selected = [r for r in groups if r["difference_type"] == kind]
    print(f"Container groups: {len(selected)}; showing largest five")
    for row in selected[:5]:
        side = "akash" if kind == "AKASH_ONLY" else "baseline"
        labels = json.loads(row[side + "_container_names_json"])
        title = "; ".join(
            " / ".join(values) or key for key, values in labels.items()
        )
        print(f"  {row['task_count']} tasks | "
              f"{g.display(g.number(row['baseline_minus_akash_hours']))} h | "
              f"{title}")
PY
