"""Independent second-method verification: does the paginated
GET /folders/{id}/tasks?descendants=true&subTasks=true call return the
exact same task set as an independently-implemented manual subTaskIds
closure-walk?

This is the same core proof used for Holiday (via resolve_scope.py, which
also included some Holiday-specific extras - a folder-ancestry check and a
known-top-level-task-id check - that don't generalize to other projects).
This script isolates just the reusable part: two independently-coded ways
of asking "what are every one of this project's descendant tasks," compared
for an exact match. 0 delta means the folder endpoint's subTasks=true
already gives full recursive depth on its own - not a fluke specific to
Holiday's data shape.

Usage:
    python3 verify_closure_depth.py \
        --project-id MQAAAABooWQv \
        --project-name "FY26 Earth Day"
"""

from __future__ import annotations

import argparse
import getpass
import os
import time
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime

import requests

API_BASE = "https://www.wrike.com/api/v4"


def token() -> str:
    value = os.getenv("WRIKE_TOKEN", "").strip()
    return value or getpass.getpass("Wrike token (hidden; not saved): ").strip()


def get_with_backoff(url, headers, params=None, max_retries=6, timeout=60):
    for attempt in range(max_retries):
        resp = requests.get(url, headers=headers, params=params, timeout=timeout)
        if resp.status_code != 429 or attempt == max_retries - 1:
            return resp
        retry_after = resp.headers.get("Retry-After")
        wait = None
        if retry_after:
            try:
                wait = max(0.0, float(retry_after))
            except ValueError:
                try:
                    retry_dt = parsedate_to_datetime(retry_after)
                    if retry_dt.tzinfo is None:
                        retry_dt = retry_dt.replace(tzinfo=timezone.utc)
                    wait = max(0.0, (retry_dt - datetime.now(timezone.utc)).total_seconds())
                except (TypeError, ValueError):
                    wait = None
        if wait is None:
            wait = min(120, 5 * (2 ** attempt))
        print(f"Rate limited (429). Waiting {wait:.0f}s before retry {attempt + 1}/{max_retries}...")
        time.sleep(wait)
    return resp


def fetch_all_folder_tasks(project_id: str, headers: dict) -> list[dict]:
    """Method A: the authoritative, paginated folder endpoint."""
    all_tasks: list[dict] = []
    next_page_token = None
    page = 1
    while True:
        params = (
            {"nextPageToken": next_page_token}
            if next_page_token
            else {"descendants": "true", "subTasks": "true", "fields": '["subTaskIds"]'}
        )
        resp = get_with_backoff(f"{API_BASE}/folders/{project_id}/tasks", headers, params=params)
        if not resp.ok:
            print(f"\nRequest failed ({resp.status_code}) for URL: {resp.url}\n{resp.text}\n")
        resp.raise_for_status()
        payload = resp.json()
        page_tasks = payload.get("data", [])
        all_tasks.extend(page_tasks)
        print(f"  [Method A] Page {page}: {len(page_tasks)} tasks (running total {len(all_tasks)})")
        next_page_token = payload.get("nextPageToken")
        if not next_page_token:
            break
        page += 1
    return all_tasks


def closure_walk(initial_tasks: list[dict], headers: dict) -> set[str]:
    """Method B: independent manual subTaskIds closure-walk, starting from
    the same initial page(s) but expanding purely via subTaskIds - a
    structurally different code path than the folder endpoint's own
    recursion, so agreement between the two is real evidence, not a
    tautology.
    """
    seen: set[str] = set()
    frontier: set[str] = set()
    for task in initial_tasks:
        seen.add(task["id"])
        frontier.update(task.get("subTaskIds") or [])
    frontier -= seen

    round_num = 1
    while frontier:
        batch = list(frontier)[:100]
        ids_param = ",".join(batch)
        resp = get_with_backoff(f"{API_BASE}/tasks/{ids_param}", headers, params={"fields": '["subTaskIds"]'})
        resp.raise_for_status()
        for task in resp.json()["data"]:
            seen.add(task["id"])
            frontier.update(task.get("subTaskIds") or [])
        frontier -= seen
        print(f"  [Method B] Closure round {round_num}: {len(seen)} tasks found so far")
        round_num += 1

    return seen


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project-id", required=True)
    parser.add_argument("--project-name", default="")
    args = parser.parse_args()

    headers = {"Authorization": f"Bearer {token()}"}

    print(f"\n{'=' * 70}\nVerifying {args.project_name or args.project_id}\n{'=' * 70}")

    print("\nMethod A: paginated folder endpoint (descendants=true, subTasks=true)")
    initial_tasks = fetch_all_folder_tasks(args.project_id, headers)
    method_a_ids = {t["id"] for t in initial_tasks}
    print(f"Method A total: {len(method_a_ids)}")

    print("\nMethod B: independent manual subTaskIds closure-walk")
    method_b_ids = closure_walk(initial_tasks, headers)
    print(f"Method B total: {len(method_b_ids)}")

    only_in_b = method_b_ids - method_a_ids
    only_in_a = method_a_ids - method_b_ids

    print(f"\n{'=' * 70}\nResult\n{'=' * 70}")
    print(f"Method A (folder endpoint):     {len(method_a_ids)}")
    print(f"Method B (closure-walk):        {len(method_b_ids)}")
    print(f"In B but not A (delta):         {len(only_in_b)}")
    print(f"In A but not B (delta):         {len(only_in_a)}")

    if not only_in_a and not only_in_b:
        print("\n0 delta both directions - the two independent methods agree EXACTLY.")
        print("The folder endpoint's subTasks=true is confirmed to reach full recursive depth for this project.")
    else:
        print("\nDELTA FOUND - the two methods disagree. Worth investigating which one is right before trusting this project's count.")


if __name__ == "__main__":
    main()
