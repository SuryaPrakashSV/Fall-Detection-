sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import wrike_task_snapshots as app


SECRET = "fake-secret-for-offline-tests"
BASE = datetime(2026, 9, 28, 12, tzinfo=timezone.utc)


class Response:
    def __init__(self, payload):
        self.data = json.dumps(payload).encode("utf-8")

    def __enter__(self):
        return self

    def __exit__(self, *args):
        return False

    def read(self, size):
        return self.data[:size]

    def getcode(self):
        return 200


class Opener:
    def __init__(self, sequence):
        self.sequence = list(sequence)
        self.requests = []

    def open(self, request, timeout):
        self.requests.append(request)
        if not self.sequence:
            raise AssertionError("Unexpected API call")
        result = self.sequence.pop(0)
        if isinstance(result, Exception):
            raise result
        return Response(result)


def task(task_id, status="Active", custom="CS1", title=None, parents=None):
    result = {"id": task_id, "title": title or "Task " + task_id, "status": status,
              "accountId": "ACCOUNT", "updatedDate": "2020-01-01T00:00:00Z",
              "superTaskIds": parents or []}
    if custom is not None:
        result["customStatusId"] = custom
    return result


def page(records, next_token=None):
    result = {"kind": "tasks", "data": records}
    if next_token is not None:
        result["nextPageToken"] = next_token
    return result


def http_error(code, retry_after=None):
    headers = {} if retry_after is None else {"Retry-After": retry_after}
    return HTTPError("https://www.wrike.com/api/v4/tasks", code, "Remote error " + SECRET,
                     headers, io.BytesIO(("private body " + SECRET).encode()))


def read_csv(path):
    with path.open(encoding="utf-8", newline="") as stream:
        return [{key: app.csv_decode(value) for key, value in row.items()} for row in csv.DictReader(stream)]


class CaptureTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.output = Path(self.temporary.name)
        self.clock = BASE

    def tearDown(self):
        self.temporary.cleanup()

    def run_capture(self, pages, user="USER", account="ACCOUNT", max_retries=0):
        sequence = [{"data": [{"id": account}]}, {"data": [{"id": user}]}] + pages
        opener = Opener(sequence)
        sleeps = []
        client = app.WrikeClient(SECRET, opener=opener, sleep=sleeps.append, pace=0,
                                 max_retries=max_retries, now=lambda: self.clock)
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            manifest, directory = app.capture(self.output, client, now=lambda: self.clock)
        self.clock += timedelta(days=1)
        return manifest, directory, opener, sleeps

    def test_full_pagination_includes_deep_subtasks_old_and_completed_tasks(self):
        records = [task("A"), task("B", status="Completed", custom="DONE", parents=["A"])]
        manifest, directory, opener, _ = self.run_capture([
            page(records, "PAGE2"), page([task("B", status="Completed", custom="DONE", parents=["A"]),
                                         task("C", parents=["B"])]),
        ])
        self.assertEqual(manifest["status"], "COMPLETE")
        self.assertEqual(manifest["counts"]["unique_tasks"], 3)
        self.assertEqual(manifest["counts"]["duplicate_records"], 1)
        self.assertEqual(manifest["counts"]["tasks_with_super_task_ids"], 2)
        self.assertEqual(manifest["counts"]["newly_visible"], 3)
        self.assertEqual(manifest["counts"]["status_changes"], 0)
        rows = read_csv(directory / manifest["files"]["snapshot"])
        self.assertEqual({row["task_id"] for row in rows}, {"A", "B", "C"})
        self.assertEqual(rows[0]["observed_at"], app.timestamp(BASE))
        self.assertNotEqual(rows[0]["observed_at"], rows[0]["source_updated_at"])
        self.assertEqual(read_csv(directory / "status_changes.csv"), [])
        self.assertEqual(read_csv(directory / "newly_visible.csv")[0]["reason"], "FIRST_BASELINE")
        for index, request in enumerate(opener.requests[2:]):
            self.assertEqual(request.method, "GET")
            self.assertEqual(urlparse(request.full_url).path, "/api/v4/tasks")
            params = parse_qs(urlparse(request.full_url).query)
            expected = {"pageSize": ["1000"], "subTasks": ["true"], "fields": ['["superTaskIds"]']}
            if index:
                expected["nextPageToken"] = ["PAGE2"]
            self.assertEqual(params, expected)  # No date, status, limit or project filter.

    def test_second_run_status_custom_status_visibility_and_metadata(self):
        baseline, _, _, _ = self.run_capture([page([
            task("A"), task("B"), task("C"), task("D"), task("F", custom=None), task("G", custom=None),
        ])])
        manifest, directory, _, _ = self.run_capture([page([
            task("A", status="Completed", custom="DONE"),
            task("B", custom="REVIEW"), task("C", title="Renamed only"),
            task("E"), task("F", custom="AVAILABLE"), task("G", custom=None),
        ])])
        self.assertEqual(manifest["previous_run_id"], baseline["run_id"])
        counts = manifest["counts"]
        self.assertEqual(counts["status_changes"], 2)
        self.assertEqual(counts["newly_visible"], 1)
        self.assertEqual(counts["missing_from_current"], 1)
        self.assertEqual(counts["status_coverage_changes"], 1)
        self.assertEqual(counts["no_status_difference_observed"], 3)
        changes = read_csv(directory / "status_changes.csv")
        self.assertEqual([row["task_id"] for row in changes], ["A", "B"])
        self.assertEqual(changes[1]["previous_status"], changes[1]["current_status"])
        self.assertEqual(changes[1]["custom_status_changed"], "true")
        self.assertEqual(changes[0]["previous_observed_at"], app.timestamp(BASE))
        self.assertEqual(changes[0]["current_observed_at"], app.timestamp(BASE + timedelta(days=1)))
        missing = read_csv(directory / "missing_from_current.csv")[0]
        self.assertEqual(missing["task_id"], "D")
        self.assertEqual(missing["reason"], "NOT_IN_CURRENT_SNAPSHOT_CAUSE_UNKNOWN")
        self.assertEqual(missing["run_id"], baseline["run_id"])

    def test_unchanged_rerun_does_not_make_status_versions(self):
        self.run_capture([page([task("A")])])
        manifest, directory, _, _ = self.run_capture([page([task("A")])])
        self.assertEqual(manifest["counts"]["status_changes"], 0)
        self.assertEqual(manifest["counts"]["no_status_difference_observed"], 1)
        self.assertEqual(read_csv(directory / "newly_visible.csv"), [])

    def test_custom_status_disappearance_is_coverage_not_transition(self):
        self.run_capture([page([task("A")])])
        manifest, directory, _, _ = self.run_capture([page([task("A", custom=None)])])
        self.assertEqual(manifest["counts"]["status_changes"], 0)
        coverage = read_csv(directory / "status_coverage_changes.csv")
        self.assertEqual(coverage[0]["reason"], "CUSTOM_STATUS_NO_LONGER_AVAILABLE")

    def test_general_change_detected_when_custom_status_is_unavailable(self):
        self.run_capture([page([task("A", custom=None)])])
        manifest, _, _, _ = self.run_capture([page([task("A", "Completed", custom=None)])])
        self.assertEqual(manifest["counts"]["status_changes"], 1)

    def test_missing_then_reappearing_is_new_visibility_not_creation(self):
        self.run_capture([page([task("A")])])
        empty, _, _, _ = self.run_capture([page([])])
        self.assertEqual(empty["counts"]["missing_from_current"], 1)
        self.assertTrue(empty["warnings"])
        manifest, directory, _, _ = self.run_capture([page([task("A")])])
        self.assertEqual(manifest["counts"]["status_changes"], 0)
        self.assertEqual(read_csv(directory / "newly_visible.csv")[0]["reason"], "NEWLY_VISIBLE_NOT_NECESSARILY_NEW")

    def test_failed_page_does_not_advance_baseline_or_report_missing(self):
        first, _, _, _ = self.run_capture([page([task("A"), task("B")])])
        failed, directory, _, _ = self.run_capture([page([task("A")], "PAGE2"), http_error(429)])
        self.assertEqual(failed["status"], "INCOMPLETE")
        self.assertEqual(failed["counts"]["unique_tasks"], 1)
        self.assertIn("429", failed["errors"][0])
        self.assertTrue((directory / failed["files"]["partial_snapshot"]).is_file())
        self.assertFalse((directory / "missing_from_current.csv").exists())
        self.assertFalse((directory / "status_changes.csv").exists())
        last, _, _, _ = self.run_capture([page([task("A", custom="REVIEW"), task("B")])])
        self.assertEqual(last["previous_run_id"], first["run_id"])
        self.assertEqual(last["counts"]["status_changes"], 1)

    def test_interrupted_run_is_ignored_as_baseline(self):
        first, _, _, _ = self.run_capture([page([task("A")])])
        interrupted = self.output / "runs" / "interrupted"
        interrupted.mkdir()
        (interrupted / "summary.json").write_text('{"status":"RUNNING"}', encoding="utf-8")
        last, _, _, _ = self.run_capture([page([task("A")])])
        self.assertEqual(last["previous_run_id"], first["run_id"])

    def test_duplicate_status_conflict_is_incomplete(self):
        manifest, _, _, _ = self.run_capture([page([task("A")], "NEXT"), page([task("A", custom="OTHER")])])
        self.assertEqual(manifest["status"], "INCOMPLETE")
        self.assertEqual(manifest["counts"]["conflicting_duplicate_records"], 1)

    def test_repeated_page_token_is_incomplete(self):
        manifest, _, _, _ = self.run_capture([page([task("A")], "SAME"), page([task("B")], "SAME")])
        self.assertEqual(manifest["status"], "INCOMPLETE")
        self.assertIn("repeated", manifest["errors"][0])

    def test_empty_page_with_more_pages_is_incomplete(self):
        manifest, _, _, _ = self.run_capture([page([], "NEXT")])
        self.assertEqual(manifest["status"], "INCOMPLETE")

    def test_invalid_task_does_not_produce_complete_snapshot(self):
        for invalid in ({"id": "A", "title": "Task"}, {"title": "Task", "status": "Active"},
                        dict(task("A"), customStatusId=123), dict(task("A"), accountId="OTHER")):
            with self.subTest(invalid=invalid):
                manifest, _, _, _ = self.run_capture([page([invalid])])
                self.assertEqual(manifest["status"], "INCOMPLETE")

    def test_invalid_response_kind_is_incomplete(self):
        manifest, _, _, _ = self.run_capture([{"kind": "folders", "data": []}])
        self.assertEqual(manifest["status"], "INCOMPLETE")

    def test_token_user_change_requires_separate_output(self):
        self.run_capture([page([task("A")])])
        manifest, _, opener, _ = self.run_capture([], user="ANOTHER_USER")
        self.assertEqual(manifest["status"], "INCOMPLETE")
        self.assertEqual(len(opener.requests), 2)
        self.assertIn("separate --output", manifest["errors"][0])

    def test_edited_baseline_fails_validation_before_api_calls(self):
        first, directory, _, _ = self.run_capture([page([task("A")])])
        path = directory / first["files"]["snapshot"]
        path.write_bytes(path.read_bytes() + b"edited\n")
        manifest, _, opener, _ = self.run_capture([])
        self.assertEqual(manifest["status"], "INCOMPLETE")
        self.assertEqual(len(opener.requests), 0)
        self.assertIn("checksum", manifest["errors"][0])

    def test_csv_roundtrip_preserves_opaque_ids_titles_and_no_false_changes(self):
        titles = ["=SUM(A1:A3)", "'already quoted", "  +formula", "@value", "-title",
                  "\tTabbed", "Newline\ncomma, café 日本", "Plain"]
        tasks = [task("Opaque_case-%d" % index, title=title) for index, title in enumerate(titles)]
        first, directory, _, _ = self.run_capture([page(tasks)])
        rows = read_csv(directory / first["files"]["snapshot"])
        self.assertEqual([row["title"] for row in rows], titles)
        last, _, _, _ = self.run_capture([page(tasks)])
        self.assertEqual(last["counts"]["status_changes"], 0)
        self.assertEqual(last["counts"]["newly_visible"], 0)

    def test_lock_prevents_concurrent_captures(self):
        with app.output_lock(self.output):
            with self.assertRaisesRegex(app.SnapshotError, "Another capture"):
                with app.output_lock(self.output):
                    self.fail("Should not acquire a second lock")

    def test_recovered_api_error_is_reported_and_secret_not_written(self):
        manifest, directory, _, sleeps = self.run_capture([http_error(429, "2"), page([task("A")])], max_retries=1)
        self.assertEqual(manifest["status"], "COMPLETE")
        self.assertEqual(manifest["counts"]["failed_request_attempts"], 1)
        self.assertEqual(sleeps, [2.0])
        self.assertTrue(any("recovered" in warning for warning in manifest["warnings"]))
        for path in directory.iterdir():
            self.assertNotIn(SECRET, path.read_text(encoding="utf-8"))
        events = [json.loads(line) for line in (directory / "requests.jsonl").read_text().splitlines()]
        self.assertTrue(any(event.get("http_status") == 429 for event in events))

    def test_reopened_task_has_a_new_difference_on_third_run(self):
        self.run_capture([page([task("A")])])
        second, _, _, _ = self.run_capture([page([task("A", "Completed", "DONE")])])
        third, directory, _, _ = self.run_capture([page([task("A", "Active", "CS1")])])
        self.assertEqual(second["counts"]["status_changes"], 1)
        self.assertEqual(third["counts"]["status_changes"], 1)
        self.assertEqual(read_csv(directory / "status_changes.csv")[0]["previous_status"], "Completed")


class ClientTests(unittest.TestCase):
    def make_client(self, sequence, max_retries=1):
        sleeps = []
        opener = Opener(sequence)
        client = app.WrikeClient(SECRET, opener=opener, sleep=sleeps.append, pace=0,
                                 max_retries=max_retries, now=lambda: BASE)
        return client, opener, sleeps

    def test_retry_after_http_date(self):
        client, _, sleeps = self.make_client([http_error(429, "Mon, 28 Sep 2026 12:00:05 GMT"), page([])])
        with contextlib.redirect_stderr(io.StringIO()):
            client.get("/tasks")
        self.assertEqual(sleeps, [5.0])

    def test_long_retry_after_stops_without_retrying_early(self):
        client, opener, sleeps = self.make_client([http_error(429, "600")])
        with self.assertRaisesRegex(app.SnapshotError, "longer than 300"):
            client.get("/tasks")
        self.assertEqual(sleeps, [])
        self.assertEqual(len(opener.requests), 1)
        self.assertEqual(client.events[0]["http_status"], 429)

    def test_forbidden_is_not_retried_or_logged_with_sensitive_body(self):
        client, opener, sleeps = self.make_client([http_error(403)])
        with self.assertRaisesRegex(app.SnapshotError, "403") as caught:
            client.get("/tasks")
        self.assertEqual(len(opener.requests), 1)
        self.assertEqual(sleeps, [])
        self.assertNotIn(SECRET, str(caught.exception))
        self.assertNotIn(SECRET, json.dumps(client.events))

    def test_transient_server_and_network_errors_are_retried(self):
        for error in (http_error(503), URLError("private detail " + SECRET)):
            with self.subTest(error=type(error).__name__):
                client, _, sleeps = self.make_client([error, page([])])
                with contextlib.redirect_stderr(io.StringIO()):
                    result = client.get("/tasks")
                self.assertEqual(result["data"], [])
                self.assertEqual(len(sleeps), 1)
                self.assertNotIn(SECRET, json.dumps(client.events))

    def test_redirects_are_not_followed(self):
        handler = app.NoRedirect()
        self.assertIsNone(handler.redirect_request(None, None, 302, "", {}, "https://example.com"))
        client, opener, sleeps = self.make_client([http_error(302)])
        with self.assertRaisesRegex(app.SnapshotError, "302"):
            client.get("/tasks")
        self.assertEqual(len(opener.requests), 1)

    def test_arbitrary_hosts_and_endpoints_are_rejected(self):
        with self.assertRaises(app.SnapshotError):
            app.WrikeClient(SECRET, host="example.com")
        client, opener, _ = self.make_client([])
        with self.assertRaises(app.SnapshotError):
            client.get("/folders")
        self.assertEqual(opener.requests, [])


