import csv
import sys
from collections import Counter
from pathlib import Path

csv.field_size_limit(sys.maxsize)
path = Path("snowflake_snapshot.csv")
timestamps = Counter()
rows = 0
bad_rows = 0

with path.open(encoding="utf-8-sig", newline="") as f:
    reader = csv.reader(f)
    headers = next(reader)
    normalized = [h.upper() for h in headers]
    stamp = normalized.index("SNAPSHOT_EXPORTED_AT") if "SNAPSHOT_EXPORTED_AT" in normalized else None
    for row in reader:
        rows += 1
        if len(row) != len(headers):
            bad_rows += 1
        if stamp is not None and len(row) > stamp:
            timestamps[row[stamp]] += 1

print("DATA ROWS:", rows)
print("COLUMNS:", len(headers))
print("ROWS WITH WRONG COLUMN COUNT:", bad_rows)
print("SNAPSHOT TIMESTAMPS:", dict(timestamps))
print("EFFORT COLUMN:", [h for h in headers if "totaleffort" in h.lower()])
PY
