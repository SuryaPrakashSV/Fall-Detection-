WITH specialist_tasks AS (
    SELECT
        COALESCE(
            NULLIF(TRIM("great_grandbaby_task_id"), ''), NULLIF(TRIM("grandbaby_task_id"), ''),
            NULLIF(TRIM("baby_task_id"), ''), NULLIF(TRIM("grandchild_task_id"), ''),
            NULLIF(TRIM("child_task_id"), ''), NULLIF(TRIM("parent_task_id"), '')
        ) AS task_id,
        "id" AS filed_under_project_id,
        "title" AS filed_under_project_name
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE "id" = 'MQAAAAEO6vxh'
),
holiday_tasks AS (
    SELECT DISTINCT
        COALESCE(
            NULLIF(TRIM("great_grandbaby_task_id"), ''), NULLIF(TRIM("grandbaby_task_id"), ''),
            NULLIF(TRIM("baby_task_id"), ''), NULLIF(TRIM("grandchild_task_id"), ''),
            NULLIF(TRIM("child_task_id"), ''), NULLIF(TRIM("parent_task_id"), '')
        ) AS task_id
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP."Wrike_STG"
    WHERE "id" = 'MQAAAAEIsSOV'
)
SELECT
    s.task_id,
    s.filed_under_project_id,
    s.filed_under_project_name,
    CASE WHEN s.task_id IN (SELECT task_id FROM holiday_tasks) THEN 'YES' ELSE 'NO' END AS also_appears_under_holiday
FROM specialist_tasks s
LIMIT 10;
