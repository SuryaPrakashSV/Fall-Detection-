WITH src AS (
    SELECT *
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_STG
    WHERE TRIM(CHILD_FOLDER_TITLE) ILIKE '[FR] Mac APR Update'
),
task_rows AS (
    SELECT
        COALESCE(
            NULLIF(TRIM("great_grandbaby_task_id"), ''),
            NULLIF(TRIM("grandbaby_task_id"), ''),
            NULLIF(TRIM("baby_task_id"), ''),
            NULLIF(TRIM("grandchild_task_id"), ''),
            NULLIF(TRIM("child_task_id"), ''),
            NULLIF(TRIM("parent_task_id"), '')
        ) AS task_id,

        NULLIF(NULLIF(TRIM("ownerIds"), ''), '[]') AS owner_ids,
        NULLIF(TRIM("Owner_userid"), '') AS owner_user_id,
        NULLIF(TRIM("OwnerName"), '') AS owner_name,
        NULLIF(TRIM("Responsible_userId"), '') AS responsible_user_id

    FROM src
    WHERE COALESCE(
        NULLIF(TRIM("great_grandbaby_task_id"), ''),
        NULLIF(TRIM("grandbaby_task_id"), ''),
        NULLIF(TRIM("baby_task_id"), ''),
        NULLIF(TRIM("grandchild_task_id"), ''),
        NULLIF(TRIM("child_task_id"), ''),
        NULLIF(TRIM("parent_task_id"), '')
    ) IS NOT NULL
)
SELECT 'OWNER_IDS_PRESENT' AS metric,
       COUNT_IF(owner_ids IS NOT NULL) AS result
FROM task_rows
UNION ALL
SELECT 'OWNER_USER_ID_PRESENT',
       COUNT_IF(owner_user_id IS NOT NULL)
FROM task_rows
UNION ALL
SELECT 'OWNER_NAME_PRESENT',
       COUNT_IF(owner_name IS NOT NULL)
FROM task_rows
UNION ALL
SELECT 'RESPONSIBLE_USER_ID_PRESENT',
       COUNT_IF(responsible_user_id IS NOT NULL)
FROM task_rows
UNION ALL
SELECT 'ANY_ASSIGNEE_REFERENCE_PRESENT',
       COUNT_IF(
           COALESCE(
               owner_ids,
               owner_user_id,
               owner_name,
               responsible_user_id
           ) IS NOT NULL
       )
FROM task_rows
UNION ALL
SELECT 'ASSIGNEE_ID_WITHOUT_NAME',
       COUNT_IF(
           owner_name IS NULL
           AND COALESCE(
               owner_ids,
               owner_user_id,
               responsible_user_id
           ) IS NOT NULL
       )
FROM task_rows
UNION ALL
SELECT 'NO_ASSIGNEE_REFERENCE',
       COUNT_IF(
           COALESCE(
               owner_ids,
               owner_user_id,
               owner_name,
               responsible_user_id
           ) IS NULL
       )
FROM task_rows;
