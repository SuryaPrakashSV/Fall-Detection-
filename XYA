SELECT
    PROJECT_ID,
    PROJECT_NAME,

    COUNT(DISTINCT TRIM(CUSTOM_STATUS)) AS DISTINCT_PROJECT_STATUSES,

    LISTAGG(
        DISTINCT TRIM(CUSTOM_STATUS),
        ' | '
    ) WITHIN GROUP (
        ORDER BY TRIM(CUSTOM_STATUS)
    ) AS PROJECT_STATUSES_FOUND,

    COUNT(*) AS ROW_COUNT

FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_APL_BAU_PROJECT_LEVEL

WHERE PROJECT_ID IS NOT NULL
  AND CUSTOM_STATUS IS NOT NULL
  AND TRIM(CUSTOM_STATUS) <> ''

  AND TRIM(CUSTOM_STATUS) IN (
      'Not Started',
      'PM pending',
      'Planning/Resourcing',
      'In Progress',
      'PM Task/Milestone',
      'New',
      'Completed',
      'Completed - Delayed',
      'PM - Completed',
      'Backlog',
      'On Hold',
      'Absorbed Scope',
      'Cancelled'
  )

GROUP BY
    PROJECT_ID,
    PROJECT_NAME

HAVING COUNT(DISTINCT TRIM(CUSTOM_STATUS)) > 1

ORDER BY
    DISTINCT_PROJECT_STATUSES DESC,
    ROW_COUNT DESC;
