SELECT
    PROJECT_ID,
    PROJECT_NAME,
    COUNT(DISTINCT CUSTOM_STATUS_ID) AS DISTINCT_STATUS_IDS,
    LISTAGG(
        DISTINCT CUSTOM_STATUS_ID,
        ' | '
    ) WITHIN GROUP (
        ORDER BY CUSTOM_STATUS_ID
    ) AS STATUS_IDS_FOUND,
    COUNT(*) AS ROW_COUNT
FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.PROJECT_AGGLEVEL
WHERE PROJECT_ID IS NOT NULL
  AND CUSTOM_STATUS_ID IS NOT NULL
GROUP BY
    PROJECT_ID,
    PROJECT_NAME
HAVING COUNT(DISTINCT CUSTOM_STATUS_ID) > 1
ORDER BY
    DISTINCT_STATUS_IDS DESC,
    ROW_COUNT DESC;
