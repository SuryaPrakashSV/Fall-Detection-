"""Command-line POC for real API testing and offline integration demos."""

from __future__ import annotations

import argparse
import getpass
import json
import os
from pathlib import Path

import pandas as pd

from status_history_core import (
    attach_to_project_rows,
    lifecycle_metrics,
    normalize_bi_export,
    normalize_events,
)
def token() -> str:
    value = os.getenv("WRIKE_TOKEN", "").strip()
    return value or getpass.getpass("Wrike token (hidden; not saved): ").strip()


def dated_output_dir(base: str) -> Path:
    """Namespace a diagnostic output directory by UTC date (base/YYYYMMDD/).

    A rerun on a later day writes to a new folder instead of silently
    overwriting the previous day's evidence. These are point-in-time
    snapshots and cannot be recreated once lost — see the deleted UAT
    tracker copies incident (2026-08-27), which is exactly this failure
    mode and is why this exists.
    """
    stamp = pd.Timestamp.now(tz="UTC").strftime("%Y%m%d")
    path = Path(base) / stamp
    path.mkdir(parents=True, exist_ok=True)
    return path


def write_outputs(history: pd.DataFrame, output: Path, diagnostics: dict | None = None) -> None:
    output.mkdir(parents=True, exist_ok=True)
    history.to_csv(output / "project_status_history.csv", index=False)
    lifecycle_metrics(history).to_csv(output / "project_status_lifecycle.csv", index=False)
    if diagnostics is not None:
        (output / "diagnostics.json").write_text(json.dumps(diagnostics, indent=2, default=str))
    print(f"Wrote {len(history)} history rows to {output}")


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    audit = sub.add_parser("audit-backfill")
    audit.add_argument("--project-id", action="append", required=True)
    audit.add_argument("--start", default="2024-01-01T00:00:00Z")
    audit.add_argument("--end")
    audit.add_argument("--output", default="wrike_status_output")
    bi = sub.add_parser("bi-normalize")
    bi.add_argument("--bi-dir", required=True)
    bi.add_argument("--output", default="wrike_status_output")
    webhook = sub.add_parser("webhook-normalize")
    webhook.add_argument("--input", required=True)
    webhook.add_argument("--output", default="wrike_status_output")
    webhook.add_argument(
        "--source",
        default="WEBHOOK",
        help=(
            "Value written to the `source` column. Use SYNTHETIC_DEMO for "
            "fabricated sample events so they can never be mistaken for, or "
            "merged with, real Wrike history (source is part of the primary key)."
        ),
    )
    enrich = sub.add_parser("enrich-csv")
    enrich.add_argument("--wrike-stg", required=True)
    enrich.add_argument("--history", required=True)
    enrich.add_argument("--output", default="Wrike_STG_STATUS_HISTORY_POC.csv")
    inspect_webhooks = sub.add_parser(
        "inspect-webhooks",
        help="Fetch GET /webhooks and prove it returns subscription metadata, not historical status events",
    )
    inspect_webhooks.add_argument("--output", default="webhook_inspection")
    map_statuses = sub.add_parser(
        "map-statuses",
        help="Build the customStatusId -> readable status name catalog from GET /workflows",
    )
    map_statuses.add_argument("--output", default="status_catalog")
    diagnose = sub.add_parser(
        "diagnose-access",
        help="Probe each endpoint and record which are accessible with the current token",
    )
    diagnose.add_argument("--project-id", default="MQAAAAEGPpOb")
    diagnose.add_argument("--output", default="access_diagnostics")
    inspect_project = sub.add_parser(
        "inspect-project",
        help="Fetch a project and label every date/status field with what it actually means (actual event vs planned schedule value)",
    )
    inspect_project.add_argument("--project-id", default="MQAAAAEGPpOb")
    inspect_project.add_argument("--output", default="project_inspection")
    args = parser.parse_args()

    if args.command == "audit-backfill":
        from wrike_status_api import WrikeClient, WrikePermissionError

        client = WrikeClient(token())
        names = {}
        for project_id in args.project_id:
            project = client.project(project_id)
            names[project_id] = project.get("title")
        statuses = client.status_names()
        try:
            events = client.audit_log(object_ids=args.project_id, start=args.start, end=args.end)
        except WrikePermissionError as exc:
            raise SystemExit(
                f"Historical Audit Log access is blocked: {exc}\n"
                "Required: Enterprise admin, Create user activity reports, and amReadOnlyAuditLog scope."
            )
        history = normalize_events(events, source="AUDIT_LOG", project_names=names, status_names=statuses)
        write_outputs(history, Path(args.output), {"source": "AUDIT_LOG", "projects": args.project_id})
    elif args.command == "bi-normalize":
        history, diagnostics = normalize_bi_export(args.bi_dir)
        write_outputs(history, Path(args.output), diagnostics)
    elif args.command == "webhook-normalize":
        payload = json.loads(Path(args.input).read_text())
        events = payload if isinstance(payload, list) else [payload]
        history = normalize_events(events, source=args.source)
        synthetic = args.source.upper() != "WEBHOOK"
        write_outputs(
            history,
            Path(args.output),
            {
                "source": args.source.upper(),
                "synthetic": synthetic,
                "warning": (
                    "These rows were generated from fabricated sample events. The "
                    "project_id is real but the dates and statuses are invented and "
                    "do NOT reflect this project's actual Wrike history. Never present "
                    "as retrieved data."
                )
                if synthetic
                else None,
            },
        )
        if synthetic:
            print(
                f"WARNING: source={args.source.upper()} — output contains FABRICATED "
                "dates/statuses against a real project_id. Do not present as Wrike history."
            )
    elif args.command == "enrich-csv":
        wrike_stg = pd.read_csv(args.wrike_stg, low_memory=False)
        history = pd.read_csv(args.history, low_memory=False)
        enriched = attach_to_project_rows(wrike_stg, history)
        enriched.to_csv(args.output, index=False)
        print(f"Input rows={len(wrike_stg)}; output rows={len(enriched)}; wrote {args.output}")
    elif args.command == "inspect-webhooks":
        from wrike_status_api import WrikeClient

        client = WrikeClient(token())
        raw_response = client.get("webhooks")
        hooks = raw_response.get("data", [])
        output = dated_output_dir(args.output)
        (output / "webhooks_raw_response.json").write_text(
            json.dumps(raw_response, indent=2, default=str)
        )

        # Unambiguous event-shaped fields only. Deliberately excludes "status"
        # (a webhook subscription's own active/suspended flag, not a project
        # status) and "customStatusId" (ambiguous without an old/new prefix).
        historical_event_fields = {
            "projectId",
            "oldStatus",
            "newStatus",
            "oldCustomStatusId",
            "newCustomStatusId",
            "changedAt",
            "eventDate",
        }
        fields_seen = sorted({key for hook in hooks for key in hook.keys()})
        historical_fields_found = sorted(set(fields_seen) & historical_event_fields)

        report = {
            "endpoint": "GET /webhooks",
            "subscriptions_returned": len(hooks),
            "fields_seen": fields_seen,
            "historical_event_fields_found": historical_fields_found,
            "conclusion": (
                "Unambiguous historical-event fields were present; re-examine the response."
                if historical_fields_found
                else (
                    "No unambiguous historical-event fields (projectId/oldStatus/"
                    "newStatus/changedAt/etc.) are present in this response. That "
                    "alone is supporting, not conclusive, evidence. The decisive "
                    "point is structural: this endpoint accepts no date-range, "
                    "replay, or historical-event-retrieval parameters at all "
                    "(contrast with audit_log(), which takes eventDate:{start,end}). "
                    "A subscription-management resource has no mechanism to return "
                    "events that occurred before the subscription existed, "
                    "regardless of which fields a given response happens to contain."
                )
            ),
        }
        (output / "conclusion.json").write_text(json.dumps(report, indent=2))
        print(f"Fetched {len(hooks)} webhook subscription(s).")
        print(f"Fields present in response: {fields_seen}")
        print(report["conclusion"])
        print(f"Wrote raw response + conclusion to {output}/")
    elif args.command == "map-statuses":
        from wrike_status_api import CATALOG_COLUMNS, WrikeClient, flatten_workflows

        client = WrikeClient(token())
        payload = client.workflows_payload()
        catalog = flatten_workflows(payload)
        output = dated_output_dir(args.output)
        (output / "workflows_raw_response.json").write_text(
            json.dumps(payload, indent=2, default=str)
        )
        frame = pd.DataFrame(catalog, columns=CATALOG_COLUMNS)
        frame.to_csv(output / "custom_status_catalog.csv", index=False)
        (output / "custom_status_map.json").write_text(
            json.dumps({row["custom_status_id"]: row["status_name"] for row in catalog}, indent=2)
        )
        print(f"Mapped {len(catalog)} custom statuses across "
              f"{frame['workflow_id'].nunique() if not frame.empty else 0} workflow(s).")
        if not frame.empty:
            print(frame[["custom_status_id", "status_name", "status_group", "workflow_name"]].to_string(index=False))
        print(f"Wrote catalog + raw response to {output}/")
    elif args.command == "diagnose-access":
        from wrike_status_api import WrikeClient

        client = WrikeClient(token())
        window = json.dumps(
            {"start": "2024-01-01T00:00:00Z", "end": "2026-01-01T00:00:00Z"},
            separators=(",", ":"),
        )
        checks = [
            ("version", None, "Baseline: token authenticates at all"),
            (f"folders/{args.project_id}", None, "Control project metadata (current state only)"),
            ("workflows", {"includeSpaceWorkflow": "true"}, "customStatusId -> name mapping"),
            ("webhooks", None, "Webhook subscriptions (future events only, no replay)"),
            (
                "audit_log",
                {"eventDate": window, "operations": json.dumps(["TaskStatusChanged"], separators=(",", ":"))},
                "HISTORICAL PATH A - needs amReadOnlyAuditLog",
            ),
            ("data_export", None, "HISTORICAL PATH B - needs dataExportFull"),
        ]
        results = []
        for path, params, purpose in checks:
            record = client.probe(path, params)
            record["purpose"] = purpose
            results.append(record)
            state = "OK" if record.get("accessible") else f"HTTP {record.get('status_code')}"
            print(f"  [{state:>8}] {record['endpoint']:<40} {purpose}")

        historical = [r for r in results if r["purpose"].startswith("HISTORICAL")]
        blocked = [r for r in historical if not r.get("accessible")]
        report = {
            "generated_at": pd.Timestamp.now(tz="UTC").strftime("%Y-%m-%dT%H:%M:%SZ"),
            "control_project_id": args.project_id,
            "checks": results,
            "historical_paths_blocked": len(blocked),
            "historical_paths_total": len(historical),
            "conclusion": (
                "Both historical paths return non-200. Every endpoint that can return "
                "past status transitions is unavailable to this token, so no backfill "
                "is possible until one scope is granted. Endpoints that do respond "
                "return current-state or subscription data only."
                if len(blocked) == len(historical)
                else "At least one historical path is now reachable — rerun the backfill."
            ),
        }
        output = dated_output_dir(args.output)
        (output / "access_diagnostics.json").write_text(json.dumps(report, indent=2, default=str))
        pd.DataFrame(results).to_csv(output / "access_diagnostics.csv", index=False)
        print(f"\n{report['conclusion']}")
        print(f"Wrote dated evidence to {output}/access_diagnostics.json")
    elif args.command == "inspect-project":
        from wrike_status_api import WrikeClient, describe_project_fields, label_custom_fields

        client = WrikeClient(token())
        project = client.project(args.project_id)
        fields = describe_project_fields(project)
        definitions = client.custom_field_definitions()
        custom_fields = label_custom_fields(project, definitions)
        output = dated_output_dir(args.output)
        (output / "project_raw_response.json").write_text(json.dumps(project, indent=2, default=str))
        (output / "field_inventory.json").write_text(json.dumps(fields, indent=2, default=str))
        (output / "custom_field_definitions_raw.json").write_text(json.dumps(definitions, indent=2, default=str))
        (output / "custom_fields_labeled.json").write_text(json.dumps(custom_fields, indent=2, default=str))

        print(f"Project: {project.get('title')} ({args.project_id})\n")
        for row in fields:
            kind = (
                "ACTUAL EVENT"
                if row["is_actual_event"]
                else "PLANNED/SCHEDULED (not an event)"
                if row["is_planned_schedule_value"]
                else "current-state field"
            )
            print(f"  {row['field_path']:<28} = {row['value']!r}")
            print(f"    [{kind}] {row['meaning']}")
        print(
            "\nNone of these fields is a status-change history record — only "
            "completedDate is tied to a specific transition. There is still no "
            "field here that says when the status became 'In Progress'. That "
            "requires Audit Log or BI Export."
        )

        print(f"\nCustom fields on this project ({len(custom_fields)}):")
        if not custom_fields:
            print("  (none set on this project)")
        for row in custom_fields:
            print(f"  {row['title']:<32} = {row['value']!r}  [{row['type']}, id={row['field_id']}]")
        print(f"\nWrote raw response + labeled inventory + custom fields to {output}/")


if __name__ == "__main__":
    main()
