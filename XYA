SELECT
    table_name,
    column_name,
    data_type
FROM GBI_RETAIL_BAP_DB.INFORMATION_SCHEMA.COLUMNS
WHERE UPPER(table_schema) = 'ASO_OPS_WSA_SNDBX_BIZ_APP'
  AND (
       UPPER(column_name) LIKE '%PROJECT%STATUS%'
       OR UPPER(column_name) LIKE '%PROJECT%CUSTOM%STATUS%'
       OR UPPER(column_name) = 'PROJECT_STATUS'
  )
ORDER BY
    table_name,
    ordinal_position;
