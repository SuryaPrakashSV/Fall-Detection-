        client = WrikeClient(token())
        project = client.project(args.project_id)
        fields = describe_project_fields(project)
        definitions = client.custom_field_definitions()
        custom_fields = label_custom_fields(project, definitions)
        hierarchy = folder_hierarchy(project)
        related_ids = hierarchy["parent_ids"] + hierarchy["child_ids"] + hierarchy["super_parent_ids"]
        folders_payload = client.folders_batch(related_ids)
