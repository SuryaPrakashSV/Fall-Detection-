                "past status transitions is unavailable to this token, so no backfill "
                "is possible until one scope is granted. Endpoints that do respond "
                "return current-state or subscription data only."
                if len(blocked) == len(historical)
                else "At least one historical path is now reachable — rerun the backfill."
            ),
        }
        output = dated_output_dir(args.output)
        (output / "access_diagnostics.json").write_text(json.dumps(report, indent=2, default=str))
        pd.DataFrame(results).to_csv(output / "access_diagnostics.csv", index=False)
        print(f"\n{report['conclusion']}")
        print(f"Wrote dated evidence to {output}/access_diagnostics.json")
    elif args.command == "verify-control":
        from wrike_status_api import WrikeClient

        client = WrikeClient(token())
        project = client.project(args.project_id)
