        print(f"\nCustom fields on this project ({len(custom_fields)}):")
        if not custom_fields:
            print("  (none set on this project)")
        for row in custom_fields:
            print(f"  {row['title']:<32} = {row['value']!r}  [{row['type']}, id={row['field_id']}]")

        print(f"\nFolder hierarchy for {labeled_hierarchy['project_name']} ({labeled_hierarchy['project_id']}):")
        for label, key in (("Super-parents", "super_parents"), ("Parents", "parents"), ("Children", "children")):
            entries = labeled_hierarchy[key]
            print(f"  {label} ({len(entries)}):")
            if not entries:
                print("    (none)")
            for entry in entries:
                print(f"    {entry['title']}  [id={entry['id']}]")

        print(f"\nWrote raw response + labeled inventory + custom fields + hierarchy to {output}/")


if __name__ == "__main__":
    main()
