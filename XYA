WITH project_actuals AS (
    SELECT
        PROJECT_TYPE,
        SUM(ACTUAL_HOURS) AS total_historical_actual_hours
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.DEMAND_FORECAST_NEW
    WHERE ACTUAL_OR_FORECAST = 'ACTUAL'
      AND BREAKDOWN_LEVEL = 'BY_PROJECT_TYPE'
      AND PROJECT_TYPE != 'ALL'
    GROUP BY PROJECT_TYPE
)
SELECT *
FROM project_actuals;
