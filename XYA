    def test_verify_control_refuses_to_reuse_control_dates_for_other_projects(self):
        # CONTROL_EXPECTATIONS (May 26 / June 10) are Akash's stated facts for
        # MQAAAAEGPpOb specifically. Silently applying them to a different
        # project produced a plausible-looking but meaningless report - this
        # is the regression test for that bug.
        other_project = {
            "id": "MQAAAAEJzdlV",
            "title": "[UK DE FR] Edu Watch Offer Update",
            "customStatusId": "STATUS_DONE",
            "completedDate": "2026-06-10T13:24:01Z",
        }

        report, checks = verify_control_project(
            other_project, status_names={"STATUS_DONE": "Completed"}, expectations=[]
        )
        self.assertEqual(report["acceptance_status"], "NO_EXPECTATIONS_PROVIDED")
        self.assertEqual(len(checks), 0)
        self.assertFalse(report["can_answer_akash_from_live_history"])
        self.assertIn("Completed", report["conclusion"])
        self.assertNotIn("May 26", report["conclusion"])

        parsed = parse_expected(["In Progress:2026-04-01", "Completed:2026-06-10"])
        report2, checks2 = verify_control_project(
            other_project, status_names={"STATUS_DONE": "Completed"}, expectations=parsed
        )
        by_status = checks2.set_index("expected_status")
        self.assertEqual(by_status.loc["Completed", "result"], "CONFIRMED_CURRENT_METADATA_ONLY")
        self.assertEqual(by_status.loc["In Progress", "result"], "MISSING_FROM_ACCESSIBLE_SOURCES")
        self.assertEqual(report2["acceptance_status"], "BLOCKED_OR_INCOMPLETE")

        # The control project itself must still work unchanged with its real dates
        control_project = {
            "id": CONTROL_PROJECT_ID,
            "title": "[FR] Mac APR Update",
            "customStatusId": "STATUS_DONE",
            "completedDate": "2026-06-10T13:24:33Z",
        }
        report3, _ = verify_control_project(
            control_project, status_names={"STATUS_DONE": "Completed"}, expectations=list(CONTROL_EXPECTATIONS)
        )
        self.assertEqual(report3["acceptance_status"], "BLOCKED_OR_INCOMPLETE")

