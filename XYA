"""Local demonstration server for signed Wrike webhook notifications.

This is a reference receiver, not an internet deployment. An approved HTTPS
service and durable Snowflake writer are required before production use.
"""

from __future__ import annotations

import argparse
import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from webhook_receiver import challenge_response, process_request, verify_signature


def validated_challenge_response(
    secret: str,
    body: bytes,
    challenge: str,
    supplied_signature: str,
) -> str:
    """Validate Wrike's secure-webhook handshake and sign its challenge."""
    if len(challenge) > 100 or not challenge.isalnum():
        raise ValueError("Invalid X-Hook-Secret challenge")
    if not verify_signature(secret, body, supplied_signature):
        raise PermissionError("Invalid X-Hook-Signature during webhook verification")
    return challenge_response(secret, challenge)


class Handler(BaseHTTPRequestHandler):
    secret = ""
    output = Path("webhook_events.ndjson")

    def do_POST(self):  # noqa: N802
        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length)
        challenge = self.headers.get("X-Hook-Secret")
        if challenge:
            try:
                response = validated_challenge_response(
                    self.secret,
                    body,
                    challenge,
                    self.headers.get("X-Hook-Signature", ""),
                )
                self.send_response(200)
                self.send_header("X-Hook-Secret", response)
                self.end_headers()
                return
            except (PermissionError, ValueError) as exc:
                self.send_response(401 if isinstance(exc, PermissionError) else 400)
                self.end_headers()
                self.wfile.write(str(exc).encode())
                return
        try:
            history = process_request(body, dict(self.headers), secret=self.secret)
            with self.output.open("a", encoding="utf-8") as stream:
                for row in history.to_dict("records"):
                    stream.write(json.dumps(row, default=str, separators=(",", ":")) + "\n")
            self.send_response(200)
            self.end_headers()
            self.wfile.write(json.dumps({"accepted": len(history)}).encode())
        except (PermissionError, ValueError, json.JSONDecodeError) as exc:
            self.send_response(401 if isinstance(exc, PermissionError) else 400)
            self.end_headers()
            self.wfile.write(str(exc).encode())


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--output", default="webhook_events.ndjson")
    args = parser.parse_args()
    secret = os.getenv("WRIKE_WEBHOOK_SECRET", "")
    if not secret:
        raise SystemExit("Set WRIKE_WEBHOOK_SECRET; never hard-code or commit it")
    Handler.secret = secret
    Handler.output = Path(args.output)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"Listening locally on http://127.0.0.1:{args.port}")
    server.serve_forever()


if __name__ == "__main__":
    main()
