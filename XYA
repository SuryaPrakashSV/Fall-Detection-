WITH src AS (
    SELECT *
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_STG
    WHERE TRIM(CHILD_FOLDER_TITLE) ILIKE '[FR] Mac APR Update'
),
task_rows AS (
    SELECT
        COALESCE(
            NULLIF(TRIM("great_grandbaby_task_id"), ''),
            NULLIF(TRIM("grandbaby_task_id"), ''),
            NULLIF(TRIM("baby_task_id"), ''),
            NULLIF(TRIM("grandchild_task_id"), ''),
            NULLIF(TRIM("child_task_id"), ''),
            NULLIF(TRIM("parent_task_id"), '')
        ) AS task_id,

        CASE
            WHEN NULLIF(TRIM("great_grandbaby_task_id"), '') IS NOT NULL
                THEN 'GREAT_GRANDBABY_TASK'
            WHEN NULLIF(TRIM("grandbaby_task_id"), '') IS NOT NULL
                THEN 'GRANDBABY_TASK'
            WHEN NULLIF(TRIM("baby_task_id"), '') IS NOT NULL
                THEN 'BABY_TASK'
            WHEN NULLIF(TRIM("grandchild_task_id"), '') IS NOT NULL
                THEN 'GRANDCHILD_SUBTASK'
            WHEN NULLIF(TRIM("child_task_id"), '') IS NOT NULL
                THEN 'CHILD_TASK'
            WHEN NULLIF(TRIM("parent_task_id"), '') IS NOT NULL
                THEN 'TOP_LEVEL_SECTION'
        END AS task_level,

        NULLIF(TRIM("status"), '') AS general_status,
        NULLIF(TRIM("customStatusId"), '') AS custom_status,
        NULLIF(TRIM("createdDate"), '') AS created_at,
        NULLIF(TRIM("updatedDate"), '') AS updated_at,
        NULLIF(TRIM("completedDate"), '') AS completed_at,
        NULLIF(TRIM("OwnerName"), '') AS assignee_name

    FROM src
    WHERE COALESCE(
        NULLIF(TRIM("great_grandbaby_task_id"), ''),
        NULLIF(TRIM("grandbaby_task_id"), ''),
        NULLIF(TRIM("baby_task_id"), ''),
        NULLIF(TRIM("grandchild_task_id"), ''),
        NULLIF(TRIM("child_task_id"), ''),
        NULLIF(TRIM("parent_task_id"), '')
    ) IS NOT NULL
)
SELECT 'TOTAL_TASK_ROWS' AS metric, COUNT(*) AS result FROM task_rows
UNION ALL
SELECT 'DISTINCT_TASK_IDS', COUNT(DISTINCT task_id) FROM task_rows
UNION ALL
SELECT 'DUPLICATE_TASK_ROWS',
       COUNT(*) - COUNT(DISTINCT task_id) FROM task_rows
UNION ALL
SELECT 'TOP_LEVEL_SECTIONS',
       COUNT_IF(task_level = 'TOP_LEVEL_SECTION') FROM task_rows
UNION ALL
SELECT 'CHILD_TASKS',
       COUNT_IF(task_level = 'CHILD_TASK') FROM task_rows
UNION ALL
SELECT 'GRANDCHILD_SUBTASKS',
       COUNT_IF(task_level = 'GRANDCHILD_SUBTASK') FROM task_rows
UNION ALL
SELECT 'BABY_TASKS',
       COUNT_IF(task_level = 'BABY_TASK') FROM task_rows
UNION ALL
SELECT 'GRANDBABY_TASKS',
       COUNT_IF(task_level = 'GRANDBABY_TASK') FROM task_rows
UNION ALL
SELECT 'GREAT_GRANDBABY_TASKS',
       COUNT_IF(task_level = 'GREAT_GRANDBABY_TASK') FROM task_rows
UNION ALL
SELECT 'CURRENT_STATUS_PRESENT',
       COUNT_IF(general_status IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'CUSTOM_STATUS_PRESENT',
       COUNT_IF(custom_status IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'CREATED_DATE_PRESENT',
       COUNT_IF(created_at IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'UPDATED_DATE_PRESENT',
       COUNT_IF(updated_at IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'COMPLETED_DATE_PRESENT',
       COUNT_IF(completed_at IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'ASSIGNEE_NAME_PRESENT',
       COUNT_IF(assignee_name IS NOT NULL) FROM task_rows
UNION ALL
SELECT 'ASSIGNEE_NAME_MISSING',
       COUNT_IF(assignee_name IS NULL) FROM task_rows;
