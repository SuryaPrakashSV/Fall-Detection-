SELECT
    COUNT_IF(TRIM(parent_folder_title) ILIKE '[FR] Mac APR Update')
        AS parent_folder_matches,

    COUNT_IF(TRIM(child_folder_title) ILIKE '[FR] Mac APR Update')
        AS child_folder_matches,

    COUNT_IF(TRIM(grandchild_folder_title) ILIKE '[FR] Mac APR Update')
        AS grandchild_folder_matches,

    COUNT_IF(TRIM(baby_folder_title) ILIKE '[FR] Mac APR Update')
        AS baby_folder_matches,

    COUNT_IF(TRIM(grandbaby_folder_title) ILIKE '[FR] Mac APR Update')
        AS grandbaby_folder_matches,

    COUNT_IF(TRIM(title) ILIKE '[FR] Mac APR Update')
        AS title_matches

FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_STG;
