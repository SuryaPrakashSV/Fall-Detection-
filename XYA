        if existing and not args.force:
            if args.secure:
                raise SystemExit(
                    "A matching webhook already exists, but Wrike does not reveal "
                    "whether it uses a signing secret. Rerun without --secure to "
                    "reuse it, or use --force only if a second registration is intended."
                )
            action = "reused_existing"
            response = {"kind": "webhooks", "data": existing}
        else:
            secret = webhook_secret() if args.secure else None
            if args.secure and not secret:
                raise SystemExit("--secure requires a non-empty webhook signing secret")
            action = "created"
            response = client.register_webhook(
                folder_id=args.folder_id,
                hook_url=hook_url,
                events=events,
                fields=fields,
                recursive=args.recursive,
                secret=secret,
            )

        report = {
            "action": action,
            "folder_id": args.folder_id,
            "events": events,
            "fields": fields,
            "recursive": args.recursive,
            "secure_requested": args.secure,
            "response": redact_webhook_response(response),
