SELECT
    PROJECT_ID,
    PROJECT_NAME,
    COUNT(DISTINCT TRIM(PROJECT_CUSTOM_STATUS)) AS DISTINCT_PROJECT_STATUSES,
    LISTAGG(
        DISTINCT TRIM(PROJECT_CUSTOM_STATUS),
        ' | '
    ) WITHIN GROUP (
        ORDER BY TRIM(PROJECT_CUSTOM_STATUS)
    ) AS PROJECT_STATUSES_FOUND,
    COUNT(*) AS ROW_COUNT
FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_PROJECT_ASSIGNEE_DETAIL
WHERE PROJECT_ID IS NOT NULL
  AND PROJECT_CUSTOM_STATUS IS NOT NULL
  AND TRIM(PROJECT_CUSTOM_STATUS) <> ''
GROUP BY
    PROJECT_ID,
    PROJECT_NAME
HAVING COUNT(DISTINCT TRIM(PROJECT_CUSTOM_STATUS)) > 1
ORDER BY
    DISTINCT_PROJECT_STATUSES DESC,
    ROW_COUNT DESC;
