    def test_describe_project_fields_labels_planned_vs_actual(self):
        # dates.start (05-10) is a planned date, not tied to the real status
        # change, and completedDate/updatedDate are a second apart on purpose
        project = {
            "id": "MQAAAAEGPpOb",
            "title": "[FR] Mac APR Update",
            "createdDate": "2026-03-11T09:00:00Z",
            "updatedDate": "2026-06-10T13:24:34Z",
            "completedDate": "2026-06-10T13:24:33Z",
            "customStatusId": "STATUS_DONE",
            "dates": {"type": "Planned", "start": "2026-05-10", "due": "2026-06-15"},
            "project": {
                "authorId": "KUAMPLE",
                "ownerIds": ["KUAMPLE"],
                "startDate": "2026-05-18",
                "endDate": "2026-06-09",
            },
        }
        fields = describe_project_fields(project)
        by_path = {row["field_path"]: row for row in fields}

        self.assertIn("dates.start", by_path)
        self.assertFalse(by_path["dates.start"]["is_actual_event"])
        self.assertTrue(by_path["dates.start"]["is_planned_schedule_value"])
        self.assertIn("PLANNED", by_path["dates.start"]["meaning"].upper())

        for real_field in ("project.startDate", "project.endDate"):
            self.assertIn(real_field, by_path)
            self.assertFalse(by_path[real_field]["is_actual_event"])
            self.assertTrue(by_path[real_field]["is_planned_schedule_value"])
            self.assertIn("PLANNED", by_path[real_field]["meaning"].upper())

        self.assertTrue(by_path["completedDate"]["is_actual_event"])
        self.assertFalse(by_path["completedDate"]["is_planned_schedule_value"])

        self.assertFalse(by_path["updatedDate"]["is_actual_event"])
        self.assertFalse(by_path["updatedDate"]["is_planned_schedule_value"])

        self.assertNotIn("project.ownerIds", by_path)  # not a date/status field, shouldn't show up

    def test_label_custom_fields_resolves_ids_to_names(self):
        project = {
            "id": "MQAAAAEGPpOb",
            "customFields": [
                {"id": "IEACF1", "value": "2026-05-26"},
                {"id": "IEACF2", "value": "Some note"},
                {"id": "IEACFMISSING", "value": "orphaned - not in account defs"},
            ],
        }
        definitions = {
            "data": [
                {"id": "IEACF1", "title": "Actual In Progress Date", "type": "Date"},
                {"id": "IEACF2", "title": "PM Notes", "type": "Text"},
            ]
        }
        rows = label_custom_fields(project, definitions)
        self.assertEqual(len(rows), 3)
        by_title = {row["title"]: row for row in rows}
        self.assertEqual(by_title["Actual In Progress Date"]["value"], "2026-05-26")
        self.assertEqual(by_title["Actual In Progress Date"]["type"], "Date")
        self.assertEqual(by_title["PM Notes"]["value"], "Some note")
        unlabeled = [row for row in rows if row["field_id"] == "IEACFMISSING"]
        self.assertEqual(len(unlabeled), 1)
        self.assertIn("unknown", unlabeled[0]["title"])
        self.assertEqual(label_custom_fields({}, definitions), [])

    def test_folder_hierarchy_extracts_ids_and_resolves_titles(self):
        project = {
            "id": "MQAAAAEGPpOb",
            "title": "[FR] Mac APR Update",
            "parentIds": ["IEAPARENT1"],
            "childIds": ["IEACHILD1", "IEACHILD2"],
            "superParentIds": ["IEASUPER1"],
        }
        hierarchy = folder_hierarchy(project)
        self.assertEqual(hierarchy["project_id"], "MQAAAAEGPpOb")
        self.assertEqual(hierarchy["parent_ids"], ["IEAPARENT1"])
        self.assertEqual(hierarchy["child_ids"], ["IEACHILD1", "IEACHILD2"])
        self.assertEqual(hierarchy["super_parent_ids"], ["IEASUPER1"])

        folders_payload = {"data": [{"id": "IEACHILD2", "title": "Subtask Alpha"}]}
        labeled = label_folder_hierarchy(hierarchy, folders_payload)
        self.assertEqual(labeled["parents"], [{"id": "IEAPARENT1", "title": "(not resolvable with current access)"}])
        self.assertEqual(
            labeled["children"],
            [
                {"id": "IEACHILD1", "title": "(not resolvable with current access)"},
                {"id": "IEACHILD2", "title": "Subtask Alpha"},
            ],
        )
        self.assertEqual(labeled["super_parents"], [{"id": "IEASUPER1", "title": "(not resolvable with current access)"}])

        empty = folder_hierarchy({"id": "X"})
        self.assertEqual(empty["parent_ids"], [])
        self.assertEqual(label_folder_hierarchy(empty, {"data": []}), {
            "project_id": "X", "project_name": None, "parents": [], "children": [], "super_parents": [],
        })

    def test_control_verification_rejects_synthetic_and_marks_missing_history(self):
        project = {
            "id": "MQAAAAEGPpOb",
            "title": "[FR] Mac APR Update",
            "customStatusId": "STATUS_DONE",
            "completedDate": "2026-06-10T13:24:33Z",
        }
        fabricated = normalize_events(
            [
                {
                    "eventType": "ProjectStatusChanged",
                    "taskId": "MQAAAAEGPpOb",
                    "status": "In Progress",
                    "lastUpdatedDate": "2026-05-26T07:38:00Z",
                    "idempotencyKey": "demo-event-in-progress",
                },
                {
                    "eventType": "ProjectStatusChanged",
                    "taskId": "MQAAAAEGPpOb",
                    "status": "Completed",
                    "lastUpdatedDate": "2026-06-10T13:24:33Z",
                    "idempotencyKey": "demo-event-completed",
                },
            ],
            source="WEBHOOK",
        )
        report, checks = verify_control_project(
            project,
            status_names={"STATUS_DONE": "Completed"},
            history=fabricated,
        )

        by_status = checks.set_index("expected_status")
        self.assertEqual(
            by_status.loc["In Progress", "result"], "REJECTED_SYNTHETIC_MATCH"
        )
        self.assertEqual(
            by_status.loc["Completed", "result"], "CONFIRMED_CURRENT_METADATA_ONLY"
        )
        self.assertEqual(report["acceptance_status"], "BLOCKED_OR_INCOMPLETE")
        self.assertFalse(report["can_answer_akash_from_live_history"])

