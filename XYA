WITH target AS (
    SELECT
        PROJECT_ID,
        PROJECT_NAME,
        WRIKE_FOLDER,
        PROJECT_TYPE,
        TRY_TO_DATE(PROJECT_START_DATE) AS PROJECT_START_DATE,
        TRY_TO_DATE(PROJECT_END_DATE) AS PROJECT_END_DATE,
        CUSTOM_STATUS,
        FUNCTION_ORGANIZATION
    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_API_BAU_PROJECT_LEVEL
    WHERE PROJECT_ID = 'MQAAAAEGPpOb'
),

candidates AS (
    SELECT DISTINCT
        p.PROJECT_ID,
        p.PROJECT_NAME,
        p.WRIKE_FOLDER,
        p.PROJECT_TYPE,
        TRY_TO_DATE(p.PROJECT_START_DATE) AS PROJECT_START_DATE,
        TRY_TO_DATE(p.PROJECT_END_DATE) AS PROJECT_END_DATE,
        p.CUSTOM_STATUS,
        p.FUNCTION_ORGANIZATION,

        CASE
            WHEN p.PROJECT_TYPE = t.PROJECT_TYPE THEN 4
            ELSE 0
        END
        +
        CASE
            WHEN p.FUNCTION_ORGANIZATION = t.FUNCTION_ORGANIZATION THEN 4
            ELSE 0
        END
        +
        CASE
            WHEN p.WRIKE_FOLDER = t.WRIKE_FOLDER THEN 2
            ELSE 0
        END
        +
        CASE
            WHEN p.CUSTOM_STATUS = t.CUSTOM_STATUS THEN 2
            ELSE 0
        END AS SIMILARITY_SCORE,

        ABS(
            DATEDIFF(
                'day',
                TRY_TO_DATE(p.PROJECT_END_DATE),
                t.PROJECT_END_DATE
            )
        ) AS END_DATE_DISTANCE_DAYS

    FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.WRIKE_API_BAU_PROJECT_LEVEL p
    CROSS JOIN target t

    WHERE p.PROJECT_ID <> t.PROJECT_ID
      AND p.PROJECT_ID IS NOT NULL
      AND p.CUSTOM_STATUS = 'Completed'
)

SELECT
    PROJECT_ID,
    PROJECT_NAME,
    PROJECT_TYPE,
    FUNCTION_ORGANIZATION,
    WRIKE_FOLDER,
    PROJECT_START_DATE,
    PROJECT_END_DATE,
    CUSTOM_STATUS,
    SIMILARITY_SCORE,
    END_DATE_DISTANCE_DAYS
FROM candidates
ORDER BY
    SIMILARITY_SCORE DESC,
    END_DATE_DISTANCE_DAYS ASC
LIMIT 20;
