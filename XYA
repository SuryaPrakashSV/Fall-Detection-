SELECT
    ORDINAL_POSITION,
    COLUMN_NAME,
    DATA_TYPE
FROM GBI_RETAIL_BAP_DB.INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'ASO_OPS_WSA_SNDBX_BIZ_APP'
  AND TABLE_NAME = 'WRIKE_STG'
  AND (
      UPPER(COLUMN_NAME) LIKE '%STATUS%'
      OR UPPER(COLUMN_NAME) LIKE '%HISTORY%'
      OR UPPER(COLUMN_NAME) LIKE '%TRANSITION%'
      OR UPPER(COLUMN_NAME) LIKE '%CHANGED%'
  )
ORDER BY ORDINAL_POSITION;
