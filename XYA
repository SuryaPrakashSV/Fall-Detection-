        print(f"Wrote catalog + raw response to {output}/")
    elif args.command == "diagnose-access":
        from wrike_status_api import WrikeClient

        client = WrikeClient(token())
        checks = [
            ("version", None, "Baseline: token authenticates at all"),
            (f"folders/{args.project_id}", None, "Control project metadata (current state only)"),
            ("workflows", {"includeSpaceWorkflow": "true"}, "customStatusId -> name mapping"),
            ("webhooks", None, "Webhook subscriptions (future events only, no replay)"),
            (
                f"folders/{args.project_id}/comments",
                None,
                "NEW LEAD (untested) - does this reach the same activity feed shown in the Wrike UI?",
            ),
        ] + control_history_probe_specs(args.project_id)
        results = []
        for path, params, purpose in checks:
            record = client.probe(path, params)
            record["purpose"] = purpose
            results.append(record)
            state = "OK" if record.get("accessible") else f"HTTP {record.get('status_code')}"
            print(f"  [{state:>8}] {record['endpoint']:<40} {purpose}")

        historical = [r for r in results if r["purpose"].startswith("HISTORICAL")]
        blocked = [r for r in historical if not r.get("accessible")]
        report = {
            "generated_at": pd.Timestamp.now(tz="UTC").strftime("%Y-%m-%dT%H:%M:%SZ"),
            "control_project_id": args.project_id,
            "checks": results,
            "historical_paths_blocked": len(blocked),
