SELECT
    PROJECT_ID,
    PROJECT_NAME,
    COUNT(DISTINCT PROJECT_CUSTOM_STATUS) AS DISTINCT_PROJECT_STATUSES,
    LISTAGG(
        DISTINCT PROJECT_CUSTOM_STATUS,
        ' | '
    ) WITHIN GROUP (
        ORDER BY PROJECT_CUSTOM_STATUS
    ) AS PROJECT_STATUSES_FOUND,
    COUNT(*) AS ROW_COUNT
FROM GBI_RETAIL_BAP_DB.ASO_OPS_WSA_SNDBX_BIZ_APP.BAU_OWNER
WHERE PROJECT_ID IS NOT NULL
  AND PROJECT_CUSTOM_STATUS IS NOT NULL
GROUP BY
    PROJECT_ID,
    PROJECT_NAME
HAVING COUNT(DISTINCT PROJECT_CUSTOM_STATUS) > 1
ORDER BY
    DISTINCT_PROJECT_STATUSES DESC,
    ROW_COUNT DESC;
