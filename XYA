SELECT
    table_schema,
    table_name,
    table_type,
    created,
    last_altered,
    retention_time
FROM GBI_RETAIL_BAP_DB.INFORMATION_SCHEMA.TABLES
WHERE (
       UPPER(table_name) LIKE '%WRIKE%'
    OR UPPER(table_name) LIKE '%HISTORY%'
    OR UPPER(table_name) LIKE '%SNAPSHOT%'
    OR UPPER(table_name) LIKE '%ARCHIVE%'
    OR UPPER(table_name) LIKE '%BACKUP%'
)
ORDER BY
    created,
    table_schema,
    table_name;
