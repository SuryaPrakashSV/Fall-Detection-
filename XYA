SELECT
    table_name,
    ordinal_position,
    column_name,
    data_type
FROM GBI_RETAIL_BAP_DB.INFORMATION_SCHEMA.COLUMNS
WHERE UPPER(table_schema) = 'ASO_OPS_WSA_SNDBX_BIZ_APP'
  AND UPPER(table_name) IN (
      'PROJECT_DAILYLEVEL_NEW',
      'PROJECT_AGGLEVEL',
      'OWNER_PROJECT_WEEKLY_AGG',
      'OWNER_PROJECT_WEEKLY_AGG_NEW',
      'BAU_OWNER'
  )
ORDER BY
    table_name,
    ordinal_position;
