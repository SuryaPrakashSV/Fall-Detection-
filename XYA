import json
from collections import Counter

with open("fr_mac_task_history_raw.json", encoding="utf-8") as file:
    evidence = json.load(file)

payload = evidence.get("response", evidence)
key_matches = Counter()
value_matches = Counter()

def scan(value):
    if isinstance(value, dict):
        for key, child in value.items():
            if "status" in str(key).lower():
                key_matches[str(key)] += 1
            scan(child)
    elif isinstance(value, list):
        for child in value:
            scan(child)
    elif isinstance(value, str) and "status" in value.lower():
        value_matches[value] += 1

scan(payload)

print("Status-key matches:", dict(key_matches))
print("Status-value matches:", dict(value_matches))
print("Total status mentions:", sum(key_matches.values()) + sum(value_matches.values()))
